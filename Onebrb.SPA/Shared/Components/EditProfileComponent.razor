@using AutoMapper
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Onebrb.SPA.Models
@using System.Security.Claims
@using System.Net
@using System.Text.Json
@using Onebrb.SPA.Shared.Components
@using OnebrbApi
@using System.Text.RegularExpressions;

@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IToastService ToastService

@inject IStringLocalizer<Pages.Home.Profile.Profile> Localizer
@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared

@inject DialogService DialogService
@implements IDisposable

@if (_updatedUserProfile)
{
    ToastService.ClearAll();
    ToastService.ShowSuccess(@Localizer["EditProfile_UpdatedSuccessfully"]);
}

@if (_updateUserProfileError)
{
    ToastService.ClearAll();
    ToastService.ShowError(@LocalizerShared["EditProfile_NotUpdatedSuccessfully"]);
}
<div class="EditProfileComponent">
    @if (@CurrentUser is null && _occupations is null)
    {
        <RadzenCard>
            <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">@LocalizerShared["Loading"]</RadzenText>
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </RadzenCard>
    }
    else
    {
        <RadzenTemplateForm Data="CurrentUser">
            <div class="row">
                <div class="EditProfileComponent__form">
                    <div class="row">

                        <div class="EditProfileComponent__form__input-div">
                            <RadzenCard>
                                <p>@Localizer["EditProfile_ProfilePhoto"]</p>
                                <RadzenFileInput Value="@CurrentUser.Photo" TValue=string Change=@(args => OnProfilePhotoChange(args)) />
                            </RadzenCard>
                        </div>

                        <div class="EditProfileComponent__form__input-div">
                            <RadzenTextBox style="width: 100%;" Name=@Localizer["EditProfile_FirstName"] Placeholder=@Localizer["EditProfile_FirstName"] @bind-Value="@CurrentUser.FirstName" MaxLength="@_firstNameMaxLength" />
                        </div>
                        <div class="EditProfileComponent__form__input-div">
                            <RadzenTextBox style="width: 100%;" Name=@Localizer["EditProfile_LastName"] Placeholder=@Localizer["EditProfile_LastName"] @bind-Value="@CurrentUser.LastName" MaxLength="@_lastNameMaxLength" />
                        </div>
                        <div class="EditProfileComponent__form__input-div">
                            <RadzenTextBox style="width: 100%;" Name=@Localizer["EditProfile_Email"] Placeholder=@Localizer["EditProfile_Email"] @bind-Value="@CurrentUser.Email" Disabled />
                            <RadzenCard class="EditProfileComponent__form__privacy-toggle">
                                <div class="privacy-toggle__lock">
                                    <i class="bi bi-file-lock2-fill"></i>
                                </div>
                                <RadzenSelectBar Size="ButtonSize.Small" @bind-Value=@CurrentUser.IsEmailVisible TValue="bool" Change=@(args => OnEmailPrivacyChange(args))>
                                    <Items>
                                        <RadzenSelectBarItem Text=@Localizer["EditProfile_PrivacyEveryone"] Value="true" />
                                        <RadzenSelectBarItem Text=@Localizer["EditProfile_PrivacyOnlyMe"] Value="false" />
                                    </Items>
                                </RadzenSelectBar>
                            </RadzenCard>
                        </div>

                        @*TODO: Phone validation - until then not showing phones*@
                        @*                        <div class="EditProfileComponent__form__input-div">
                    <RadzenTextBox style="width: 100%;" Name="Phone" Placeholder="Phone number" @bind-Value="@CurrentUser.Phone" MaxLength="@_phoneMaxLength" />
                    <RadzenCard class="EditProfileComponent__form__privacy-toggle" Visible=(!string.IsNullOrWhiteSpace(CurrentUser.Phone))>
                    <div class="privacy-toggle__lock">
                    <i class="bi bi-file-lock2-fill"></i>
                    </div>
                    <RadzenSelectBar Size="ButtonSize.Small" @bind-Value=@CurrentUser.IsPhoneVisible TValue="bool?" Change=@(args => OnPhonePrivacyChange(args))>
                    <Items>
                    <RadzenSelectBarItem Text="Everyone" Value="true" />
                    <RadzenSelectBarItem Text="Only me" Value="false" />
                    </Items>
                    </RadzenSelectBar>
                    </RadzenCard>
                    </div>*@

                        <div class="EditProfileComponent__form__input-div">
                            <RadzenCard>
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">@Localizer["EditProfile_Occupation"]</RadzenText>
                                <RadzenDropDown AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data=@_occupations @bind-Value=@_userOccupation.Id
                                            TextProperty="Name" ValueProperty="Id" Change=@(args => OnOccupationChange(args)) Class="w-100" />
                            </RadzenCard>
                        </div>

                        <div class="EditProfileComponent__form__input-div">
                            <RadzenCard>
                                <h4 class="mb-4">@Localizer["EditProfile_About"]</h4>
                                <RadzenTextArea Class="w-100" @bind-Value="@CurrentUser.About" Name="aboutTextarea" Placeholder=@Localizer["EditProfile_AboutWriteSomething"] MaxLength="@_aboutMaxLength" />
                                <span>(@string.Format(@Localizer["EditProfile_AboutMaxLength"], _aboutMaxLength))</span>
                            </RadzenCard>
                        </div>

                        <div class="EditProfileComponent__social">
                            <div class="EditProfileComponent__form__input-div">
                                <i class="bi bi-linkedin"></i>
                                <RadzenTextBox style="width: 100%;" Name=@Localizer["EditProfile_LinkedInAccount"] Placeholder=@Localizer["EditProfile_LinkedInAccount"] @bind-Value="@CurrentUser.LinkedInProfile" MaxLength=ValidationConstants.SocialAccountMaxLength />
                            </div>

                            <div class="EditProfileComponent__form__input-div">
                                <i class="bi bi-facebook"></i>
                                <RadzenTextBox style="width: 100%;" Name=@Localizer["EditProfile_FacebookAccount"] Placeholder=@Localizer["EditProfile_FacebookAccount"] @bind-Value="@CurrentUser.FacebookProfile" MaxLength=ValidationConstants.SocialAccountMaxLength />
                            </div>

                            <div class="EditProfileComponent__form__input-div">
                                <i class="bi bi-instagram"></i>
                                <RadzenTextBox style="width: 100%;" Name=@Localizer["EditProfile_InstagramAccount"] Placeholder=@Localizer["EditProfile_InstagramAccount"] @bind-Value="@CurrentUser.InstagramProfile" MaxLength=ValidationConstants.SocialAccountMaxLength />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-12 d-flex" style="margin-top: 16px;">
                    <RadzenButton ButtonType="ButtonType.Submit" Click=@(args => OnUpdateProfileClick()) Icon="save" Text=@LocalizerShared["Save"] Disabled=@_isUpdateBtnClicked />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text=@LocalizerShared["Cancel"] Click="@Cancel" Disabled=@_isUpdateBtnClicked />
                </div>
            </div>
        </RadzenTemplateForm>
    }
</div>

@code {
    [Parameter]
    public UserProfileModel? CurrentUser { get; set; }

    public ICollection<OccupationModel>? _occupations;

    public OccupationModel _userOccupation = new();

    private bool _updatedUserProfile = false;
    private bool _isUpdateBtnClicked = false;
    private bool _updateUserProfileError = false;

    private IEnumerable<int> values = new int[] { 1, 2 };

    private int _firstNameMaxLength = 30;
    private int _lastNameMaxLength = 30;
    private int _phoneMaxLength = 20;
    private int _aboutMaxLength = 500;

    string fileName;
    long? fileSize;

    protected override async Task OnInitializedAsync()
    {
        var occupationsResponse = await OnebrbApiClient.ApiOccupationsAsync();

        if (occupationsResponse.StatusCode == (int)HttpStatusCode.OK)
        {
            _occupations = Mapper.Map<ICollection<OccupationModel>>(occupationsResponse.Result);

            // Get current user's occupation
            try
            {
                var currentUserOccupationResponse = await OnebrbApiClient.ApiUsersOccupationAsync(CurrentUser.Id);
                _userOccupation = Mapper.Map<OccupationModel>(currentUserOccupationResponse.Result);
            }
            catch (ApiException<ProblemDetails> ex)
            {
                ToastService.ClearAll();

                if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
                {
                    ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
                }
            }
            catch (Exception)
            {
                _userOccupation = new OccupationModel { Name = "" };
            }
        }
    }

    void OnProfilePhotoChange(string value)
    {
        CurrentUser.Photo = value;
    }

    void OnProfilePhotoChangeError(UploadErrorEventArgs args)
    {
    }

    void OnOccupationChange(object value)
    {
        CurrentUser.OccupationId = value.ToString();
        var str = value is IEnumerable<object> ? string.Join(", ", (IEnumerable<object>)value) : value;
    }

    void OnEmailPrivacyChange(object value)
    {
        var str = value is IEnumerable<int> ? string.Join(", ", (IEnumerable<int>)value) : value;
    }

    void OnPhonePrivacyChange(object value)
    {
        var str = value is IEnumerable<int> ? string.Join(", ", (IEnumerable<int>)value) : value;
    }

    async Task OnUpdateProfileClick()
    {
        _isUpdateBtnClicked = true;

        // Validate social accounts
        if (Utils.AtLeastOneNull(CurrentUser.LinkedInProfile, CurrentUser.FacebookProfile, CurrentUser.InstagramProfile))
        {
            var urlRegex = new Regex(@"((?:(?:http|ftp|ws)s?|sftp):\/\/?)?([^:/\s.#?]+\.[^:/\s#?]+|localhost)(:\d+)?((?:\/\w+)*\/)?([\w\-.]+[^#?\s]+)?([^#]+)?(#[\w-]*)?");

            if (CurrentUser.LinkedInProfile is not null)
            {
                if (urlRegex.IsMatch(CurrentUser.LinkedInProfile))
                {
                    await DialogService.OpenAsync("LinkedIn Account Error", ds =>
                    @<div>
                        The LinkedIn account cannot contain any urls / website links.
                    </div>
                    , new DialogOptions() { CloseDialogOnOverlayClick = true });
                    return;
                }
            }

            if (CurrentUser.FacebookProfile is not null)
            {
                if (urlRegex.IsMatch(CurrentUser.FacebookProfile))
                {
                    await DialogService.OpenAsync("Facebook Account Error", ds =>
                    @<div>
                        The Facebook account cannot contain any urls / website links.
                    </div>
            , new DialogOptions() { CloseDialogOnOverlayClick = true });
                    return;
                }
            }

            if (CurrentUser.InstagramProfile is not null)
            {
                if (urlRegex.IsMatch(CurrentUser.InstagramProfile))
                {
                    await DialogService.OpenAsync("Facebook Account Error", ds =>
                    @<div>
                        The Instagram account cannot contain any urls / website links.
                    </div>
        , new DialogOptions() { CloseDialogOnOverlayClick = true });
                    return;
                }
            }
        }

        try
        {
            var model = Mapper.Map<UpdateUserProfileRequestModel>(CurrentUser);

            var updateUserResponse = await OnebrbApiClient.ApiUsersPatchAsync(model);

            if (updateUserResponse.StatusCode == (int)HttpStatusCode.OK)
            {
                CurrentUser = Mapper.Map<UserProfileModel>(updateUserResponse.Result);
            }

            if (CurrentUser is not null)
                _updatedUserProfile = true;
            else
                _updateUserProfileError = true;
        }
        catch (ApiException<ProblemDetails> ex)
        {
            ToastService.ClearAll();

            if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
            {
                ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
            }
        }
        catch (Exception)
        {
            ToastService.ShowError(@LocalizerShared["ErrorGenericMessage"]);
        }
    }

    void Cancel()
    {
        //
    }

    void Open(string title, Type type, Dictionary<string, object> parameters, DialogOptions options)
    {
    }

    void Close(dynamic result)
    {
    }

    public void Dispose()
    {
        DialogService.OnOpen -= Open;
        DialogService.OnClose -= Close;
    }
}
