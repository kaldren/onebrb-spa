@using System.Globalization
@using AutoMapper
@using Onebrb.SPA.Models
@using Onebrb.SPA.Pages.Home.Profile
@using OnebrbApi
@using System.Net

@inject IStringLocalizer<Onebrb.SPA.Pages.Home.Profile.Profile> Localizer
@inject IStringLocalizer<Onebrb.SPA.Pages.Home.Shared.Shared> LocalizerShared
@inject IMapper Mapper

@if (ProfileModel is null)
{
    <p>@Localizer["ErrorLoadingProfile"]</p>

    return;
}
else
{
    @if (CurrentUser is not null && ProfileModel is not null)
    {
        <div class="profile-component">
            <div>
                <div class="profile-component__profile-rating">
                    @if (ProfileModel.Rating.HasValue)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Primary">
                            <StarComponent Value="@ProfileModel.Rating.Value" />
                        </RadzenBadge>
                    }
                </div>
                <RadzenCard class="profile-component__header-info">
                    <h3 class="h5">@Localizer["Profile"]</h3>
                    <div class="d-flex flex-row">
                        @if (CurrentUser.Photo is not null)
                        {
                            <RadzenImage Path=@CurrentUser.Photo Class="profile-component__header-info__photo rounded-circle float-left mr-3" Style="width: 140px; height: 140px;" />
                        }
                        else
                        {
                            <img src="/img/no-photo.svg" alt="Profile photo" width="140" height="140" />
                        }
                        <div class="profile-component__header-info__main-info">
                            <div>@Localizer["ProfileName"]</div>
                            <b>@(ProfileModel.FirstName + " " + ProfileModel.LastName)</b>

                            @if (Utils.AllNotNull(ProfileModel.OccupationName))
                            {
                                <div class="mt-3">@Localizer["ProfileOccupation"]</div>
                                <b>@ProfileModel.OccupationName</b>
                            }
                        </div>
                        <div class="profile-component__about-section">
                            <p>
                                @ProfileModel.About
                            </p>
                        </div>
                    </div>
                </RadzenCard>
                <RadzenCard class="profile-component__bottom-info">
                    <h3 class="h5">@Localizer["ProfileAdditionalInfo"]</h3>
                    <div class="row">

                        @if (Utils.AtLeastOneNotNull(ProfileModel?.Country, ProfileModel?.City))
                        {
                            <div class="col-md-4">
                                @if (ProfileModel?.Country is not null)
                                {
                                    <div>@Localizer["ProfileAdditionalInfoCountry"]</div>
                                    <b>@(ProfileModel.Country)</b>
                                }

                                @if (ProfileModel?.City is not null)
                                {
                                    <div class="mt-3">@Localizer["ProfileAdditionalInfoCity"]</div>
                                    <b>@(ProfileModel.City)</b>
                                }
                            </div>
                        }

                        @if (Utils.AtLeastOneNotNull(ProfileModel?.Email))
                        {
                            <div class="col-md-4">
                                @if (ProfileModel.Email is not null)
                                {
                                    <div>@Localizer["ProfileEmail"]</div>
                                    <b>@(ProfileModel.Email)</b>
                                }

                                // TODO: Phone validation - until then not showing phones
@*                                @if (ProfileModel.Phone is not null)
                                {
                                    <div class="mt-3">@Loc["ProfilePhone"]</div>
                                    <b>@(ProfileModel.Phone)</b>
                                }*@
                            </div>
                        }

                        @if (Utils.AtLeastOneNotNull(ProfileModel?.LinkedInProfile, ProfileModel?.FacebookProfile, ProfileModel?.InstagramProfile))
                        {
                            <div class="col-md-4 profile-component__bottom-info__social">
                            @if (ProfileModel.LinkedInProfile is not null)
                            {
                                <div>
                                    <a href="https://linkedin.com/in/@ProfileModel.LinkedInProfile" target="_blank">
                                        <i class="bi bi-linkedin"></i>
                                    </a>
                                </div>
                            }
                            @if (ProfileModel.FacebookProfile is not null)
                            {
                                <div>
                                    <a href="https://facebook.com/@ProfileModel.FacebookProfile" target="_blank">
                                        <i class="bi bi-facebook"></i>
                                    </a>
                                </div>
                            }
                            @if (ProfileModel.InstagramProfile is not null)
                            {
                                <div>
                                    <a href="https://instagram.com/@ProfileModel.InstagramProfile" target="_blank">
                                        <i class="bi bi-instagram"></i>
                                    </a>
                                </div>
                            }
                        </div>
                        }
                    </div>
                </RadzenCard>

                <ProfileCommentsComponent CurrentUserId="@CurrentUser.Id" RecipientId="@ProfileModel.Id" @ref="_profileCommentsComponent" />
            </div>
        </div>
    }
}



@code {
    [Parameter]
    public UserProfileModel? ProfileModel { get; set; }

    [Parameter]
    public UserProfileModel? CurrentUser { get; set; }

    [Parameter]
    public bool CurrentUserCommented { get; set; }

    private ProfileCommentsComponent _profileCommentsComponent;

    void OnPostedComment(object comment)
    {
        CommentModel newComment = (CommentModel)comment;

        CurrentUserCommented = true;
    }
}