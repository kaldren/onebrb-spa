@inherits LayoutComponentBase
@using Onebrb.SPA.Pages
@using Onebrb.SPA.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Blazored.Toast.Configuration
@using OnebrbApi
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

@inject IWebAssemblyHostEnvironment environment
@inject IToastService toastService
@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared
@inject NavigationManager Navigation


<div class="page">
    <RadzenDialog />
    <AuthorizeView>
        <Authorized>
            <SignalRNotifications />

            <div class="sidebar">
                <NavMenu />
                <footer>
                    @LocalizerShared["AllRightsReserved"]
                </footer>
            </div>
        </Authorized>
    </AuthorizeView>

    <main>
        <div class="top-row auth">
            <AuthorizeView>
                <Authorized>
                    <HiUser />
                    <NotificationAlert />
                </Authorized>
            </AuthorizeView>

            <LanguageSelector />
            <LoginDisplay />
        </div>

        <article class="content">
            <CustomErrorBoundry @ref="_errorBoundry">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    @{
                        //if (ex is ApiException<ProblemDetails>)
                        //{
                        //    toastService.ShowError(ex.Message);
                        //}
                        //else
                        //{
                        //    toastService.ShowError($"{@Loc["ErrorGenericMessage"]}");
                        //}
                        //ex
                        //toastService.ClearAll();
                        //
                    }
                    <ErrorPageComponent />
                </ErrorContent>
            </CustomErrorBoundry>
        </article>
    </main>
</div>

@code {
    private CustomErrorBoundry _errorBoundry;

    protected override void OnInitialized()
    {
        _errorBoundry = new CustomErrorBoundry();
    }
}