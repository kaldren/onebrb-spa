@using System.Globalization
@using AutoMapper
@using Onebrb.SPA.Models
@using Onebrb.SPA.Pages.Home.Profile
@using OnebrbApi
@using System.Net
@using System.Windows

@inject IStringLocalizer<Onebrb.SPA.Pages.Home.Profile.Profile> Localizer
@inject IStringLocalizer<Onebrb.SPA.Pages.Home.Shared.Shared> LocalizerShared
@inject IMapper Mapper
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject IOnebrbApiClient OnebrbApiClient
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@if (ProfileModel is null)
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">
            <p>@Localizer["LoadingProfile"]</p>
        </RadzenText>
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenCard>

    return;
}
else
{
    <div class="ProfileComponent">
        <div>
            <div class="ProfileComponent__profile-rating">
                @if (ProfileModel.Rating.HasValue)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary">
                        <StarComponent Value="@ProfileModel.Rating.Value" />
                    </RadzenBadge>
                }
            </div>
            <RadzenCard class="ProfileComponent__header-info">

                @*                    <div class="ProfileComponent__short-url">
            <RadzenTextBox Disabled="true" Class="w-100" Value="@_profileUrlShortText" />
            <CopyToClipboard Text="@_profileUrlShortText" OnClicked="@OnProfileUrlShortClicked" />
            </div>*@

                <h3 class="h5">@Localizer["Profile"]</h3>
                <div class="ProfileComponent__profile-box">
                    @if (ProfileModel?.Photo is not null)
                    {
                        <RadzenImage Path=@ProfileModel.Photo Class="ProfileComponent__header-info__photo rounded-circle float-left mr-3" Style="width: 140px; height: 140px;" />
                    }
                    else
                    {
                        <img src="/img/no-photo.svg" alt="Profile photo" width="140" height="140" />
                    }
                    <div class="ProfileComponent__header-info__main-info">
                        <div>@Localizer["ProfileName"]</div>
                        <b>@(ProfileModel.FirstName + " " + ProfileModel.LastName)</b>

                        @if (Utils.AllNotNull(ProfileModel.OccupationName))
                        {
                            <div class="mt-3">@Localizer["ProfileOccupation"]</div>
                            <b>@ProfileModel.OccupationName</b>
                        }
                    </div>
                    <div class="ProfileComponent__about-section">
                        <p>
                            @ProfileModel.About
                        </p>
                    </div>
                </div>
            </RadzenCard>
            <RadzenCard class="ProfileComponent__bottom-info">
                <h3 class="h5">@Localizer["ProfileAdditionalInfo"]</h3>
                <div class="row">

                    @if (Utils.AtLeastOneNotNull(ProfileModel?.Country, ProfileModel?.City))
                    {
                        <div class="col-md-4">
                            @if (ProfileModel?.Country is not null)
                            {
                                <div>@Localizer["ProfileAdditionalInfoCountry"]</div>
                                <b>@(ProfileModel.Country)</b>
                            }

                            @if (ProfileModel?.City is not null)
                            {
                                <div class="mt-3">@Localizer["ProfileAdditionalInfoCity"]</div>
                                <b>@(ProfileModel.City)</b>
                            }
                        </div>
                    }

                    @if (Utils.AtLeastOneNotNull(ProfileModel?.Email))
                    {
                        <div class="col-md-4">
                            @if (ProfileModel.Email is not null)
                            {
                                <div>@Localizer["ProfileEmail"]</div>
                                <b>@(ProfileModel.Email)</b>
                            }
                        </div>
                    }

                    @if (Utils.AtLeastOneNotNull(ProfileModel?.LinkedInProfile, ProfileModel?.FacebookProfile, ProfileModel?.InstagramProfile))
                    {
                        <div class="col-md-4 ProfileComponent__bottom-info__social">
                            @if (ProfileModel.LinkedInProfile is not null)
                            {
                                <div>
                                    <a href="https://linkedin.com/in/@ProfileModel.LinkedInProfile" target="_blank">
                                        <i class="bi bi-linkedin"></i>
                                    </a>
                                </div>
                            }
                            @if (ProfileModel.FacebookProfile is not null)
                            {
                                <div>
                                    <a href="https://facebook.com/@ProfileModel.FacebookProfile" target="_blank">
                                        <i class="bi bi-facebook"></i>
                                    </a>
                                </div>
                            }
                            @if (ProfileModel.InstagramProfile is not null)
                            {
                                <div>
                                    <a href="https://instagram.com/@ProfileModel.InstagramProfile" target="_blank">
                                        <i class="bi bi-instagram"></i>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </RadzenCard>

            @if (CurrentUser is not null)
            {
                <ProfileCommentsComponent CurrentUserId="@CurrentUser.Id" RecipientId="@ProfileModel.Id" @ref="_profileCommentsComponent" />
            }
            else
            {
                <p class="ProfileComponent__sign-in-for-comments">@string.Format(LocalizerShared["SignInToSeeComments"], ProfileModel.FirstName, ProfileModel.LastName)</p>

                <LoginFormComponent />
            }
        </div>
    </div>
}

@code {
    private ProfileCommentsComponent? _profileCommentsComponent;
    private OnebrbApiResponse<UserProfileResponseModel>? _userResponse;

    private string _profileUrlShortText = "1brb.com/cvHz";
    private bool _isProfileUrlShortBtnClicked = false;

    [Parameter]
    public UserProfileModel? ProfileModel { get; set; }

    [Parameter]
    public UserProfileModel? CurrentUser { get; set; }

    [Parameter]
    public bool CurrentUserCommented { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (ProfileModel is null && CurrentUser is null)
        {
            var user = await LocalStorage.GetItemAsync<UserProfileModel>("userProfile");

            if (user is not null)
            {
                CurrentUser = user;
                ProfileModel = user;
            }
            else
            {
                // try get current user profile
                try
                {
                    _userResponse = await OnebrbApiClient.ApiUsersCurrentAsync();
                    CurrentUser = this.Mapper.Map<UserProfileModel>(_userResponse.Result);
                    ProfileModel = CurrentUser;
                    await LocalStorage.SetItemAsync<UserProfileModel>("userProfile", CurrentUser);
                }
                catch (ApiException<ProblemDetails> ex)
                {
                    ToastService.ClearAll();

                    if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
                    {
                        ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
                    }
                    if (ex.StatusCode == (int)HttpStatusCode.NotFound)
                    {
                        ToastService.ShowError(@Localizer["UserNotFound"]);
                    }
                }
                catch (Exception)
                {
                    ToastService.ShowError(@LocalizerShared["ErrorGenericMessage"]);
                }
            }
        }
    }

    private void OnPostedComment(object comment)
    {
        CommentModel newComment = (CommentModel)comment;

        CurrentUserCommented = true;
    }

    private void OnProfileUrlShortClicked()
    {
        if (_isProfileUrlShortBtnClicked == false)
        {
            ToastService.ShowSuccess("Profile url copied to clipboard.");
        }

        _isProfileUrlShortBtnClicked = true;
    }
}