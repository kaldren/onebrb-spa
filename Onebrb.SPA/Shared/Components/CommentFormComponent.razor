@using AutoMapper
@using Onebrb.SPA.Models
@using OnebrbApi
@using System.Net

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper

<div class="comment-form-component">
    <h2>Add a comment</h2>
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Rating with 5 stars</RadzenText>
        <RadzenRating Change=@(args => OnRatingChange(args)) />
    </RadzenCard>
    <TextAreaComponent OnChange="ChangeHandler" />
    <ButtonComponent Text="Post" OnClick="ClickHandler" />
</div>

@code {
    [Parameter]
    public string RecipientId { get; set; }

    [Parameter] public EventCallback OnPostedComment { get; set; }

    private int _rating;
    private string _comment = string.Empty;


    void OnRatingChange(int value)
        => _rating = value;

    async Task ClickHandler()
    {
        // Call API to create the new comment
        var comment = new PostCommentRequestModel
            {
                AuthorId = string.Empty,
                RecipientId = RecipientId,
                Content = _comment,
                Rating = _rating
            };

        var result = await OnebrbApiClient.ApiCommentsPostAsync(comment);

        if (result.StatusCode == (int) HttpStatusCode.OK)
            await OnPostedComment.InvokeAsync();
    }

    void ChangeHandler(string message)
    {
        _comment = message;
    }
}
