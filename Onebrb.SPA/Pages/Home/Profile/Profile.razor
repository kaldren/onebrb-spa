@page "/profiles/{Id}"

@using AutoMapper
@using Microsoft.AspNetCore.Authorization
@using Onebrb.SPA.Models
@using Onebrb.SPA.Shared.Components
@using OnebrbApi
@using System.Net
@attribute [Authorize]

@inject IStringLocalizer<Profile> Loc
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper

<PageTitle>Profile</PageTitle>

@if (Utils.AllNull(userByIdResponse, _currentUser, _profile))
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Loading profile...</RadzenText>
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenCard>
}
else if (userByIdResponse?.StatusCode == (int)HttpStatusCode.NotFound)
{
    <RadzenAlert AllowClose="false" AlertStyle="AlertStyle.Warning" Variant="Variant.Warning" Shade="Shade.Lighter">
        Profile not found.
    </RadzenAlert>
}
else if (userByIdResponse?.StatusCode == (int)HttpStatusCode.OK)
{
    if (Utils.AllNotNull(_currentUser, _profile))
    {
        <ProfileComponent CurrentUser="_currentUser" ProfileModel="_profile" Comments="_comments" CurrentUserCommented=_currentUserCommented />
    }
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private UserProfileModel? _currentUser;
    private UserProfileModel? _profile;
    private ICollection<CommentModel>? _comments;

    bool _currentUserCommented = true;

    OnebrbApiResponse<UserProfileResponseModel>? currentUserResponse;
    OnebrbApiResponse<UserProfileResponseModel>? userByIdResponse;
    OnebrbApiResponse<ICollection<CommentResponseModel>>? commentsResponseModel;

    //protected override async Task OnInitializedAsync()
    //{
    //    await LoadData();
    //}

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        currentUserResponse = await OnebrbApiClient.ApiUsersCurrentAsync();

        if (currentUserResponse.StatusCode != (int)HttpStatusCode.OK)
        {
            return;
        }
        _currentUser = Mapper.Map<UserProfileModel>(currentUserResponse.Result);

        userByIdResponse = await OnebrbApiClient.ApiUsersGetAsync(Id);

        if (userByIdResponse.StatusCode != (int)HttpStatusCode.OK)
        {
            return;
        }
        _profile = Mapper.Map<UserProfileModel>(userByIdResponse.Result);

        // Get comments (will show profile even if we can't fetch comments for better UX)
        commentsResponseModel = await OnebrbApiClient.ApiUsersCommentsAsync(_profile?.Id);

        // No need to make additional API calls to check if current user commented on current profile if we couldn't fetch comments in the first place
        if (commentsResponseModel.StatusCode == (int)HttpStatusCode.OK)
        {
            _comments = Mapper.Map<ICollection<CommentModel>>(commentsResponseModel.Result);

            var commentsBetweenResponse = await OnebrbApiClient.ApiCommentsGetAsync(_profile?.Id, _currentUser?.Id);

            if (commentsBetweenResponse.StatusCode == (int)HttpStatusCode.OK)
            {
                _currentUserCommented = commentsBetweenResponse.Result.Count > 0;
            }
        }
    }
}
