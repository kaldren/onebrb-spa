@page "/profiles/{Id}"

@using AutoMapper
@using Microsoft.AspNetCore.Authorization
@using Onebrb.SPA.Models
@using Onebrb.SPA.Shared.Components
@using OnebrbApi
@using System.Net
@attribute [Authorize]

@inject IStringLocalizer<Profile> Loc
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper

<PageTitle>Profile</PageTitle>

@if (_profile is null)
{
    <p>Profile not found.</p>
}
else
{
    <ProfileComponent CurrentUser="_currentUser" ProfileModel="_profile" />
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private UserProfileModel? _currentUser;
    private UserProfileModel? _profile;

    protected override async Task OnInitializedAsync()
    {
        var currentUserResponse = await OnebrbApiClient.ApiUsersCurrentAsync();

        if (currentUserResponse.StatusCode == (int)HttpStatusCode.OK)
        {
            _currentUser = Mapper.Map<UserProfileModel>(currentUserResponse.Result);

            var userByIdResponse = await OnebrbApiClient.ApiUsersGetAsync(Id);

            if (userByIdResponse.StatusCode == (int) HttpStatusCode.OK)
            {
                _profile = Mapper.Map<UserProfileModel>(userByIdResponse.Result);
            }
        }
    }
}
