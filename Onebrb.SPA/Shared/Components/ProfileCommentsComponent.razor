@using AutoMapper
@using Onebrb.SPA.Models
@using OnebrbApi
@using System.Net

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IStringLocalizer<Pages.Home.Shared.Shared> Loc
@inject IToastService ToastService

@if (Comments is null)
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Loading comments...</RadzenText>
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenCard>
}
else
{
    <RadzenTabs TabPosition="TabPosition.Top" RenderMode="TabRenderMode.Client" class="profile-comments">
        <Tabs>
            <RadzenTabsItem Text="Comments">
                @if (Comments.Count() == 0)
                {
                    <p>@Loc["UserHasNoComments"]</p>
                }
                else
                {
                    <RadzenDataList PageSize="4" WrapItems="false" AllowPaging="true" Data="@Comments" TItem="CommentModel">
                        <Template Context="comment">
                            <RadzenCard>
                                <div class="row">
                                    <div class="profile-comments__profile-box col-md-8 text-truncate">
                                        <a @onclick="() => NavigateToProfile(comment.AuthorId)">
                                            <b class="profile-comments__profile-commented-link">@(comment.AuthorFirstName) @(comment.AuthorLastName)</b>
                                        </a>
                                        <div class="profile-comments__profile-box__date">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-clock-fill" viewBox="0 0 16 16">
                                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z" />
                                            </svg>
                                            <span>@comment.DateCreated.LocalDateTime.ToString()</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 text-right profile-comments__comment-options">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Primary">
                                            <StarComponent Value="@comment.RatingValue" />
                                        </RadzenBadge>
                                    </div>
                                </div>
                                <div class="d-flex flex-row align-items-center profile-comments__content-box">
                                    <RadzenImage Path="@comment.PhotoUrl" Class="rounded-circle float-left mr-3" Style="width: 80px; height: 80px;" />
                                    <div>
                                        <div style="font-size: .8em">@comment.Content</div>
                                    </div>
                                </div>
                            </RadzenCard>
                        </Template>
                    </RadzenDataList>
                }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {

    [Parameter]
    public string RecipientId { get; set; }

    [Parameter]
    public string CurrentUserId { get; set; }

    [Parameter]
    public ICollection<CommentModel> Comments { get; set; }

    OnebrbApiResponse<ICollection<CommentResponseModel>> _commentsResponse;

    private string _updatedComment = string.Empty;

    private void NavigateToProfile(string id)
    {
        Navigation.NavigateTo($"/profiles/{id}");
    }

