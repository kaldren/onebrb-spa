@using AutoMapper
@using Onebrb.SPA.Models
@using OnebrbApi
@using System.Net

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IStringLocalizer<Pages.Home.Shared.Shared> Loc
@inject IToastService ToastService

@if (_comments is null)
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Loading comments...</RadzenText>
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenCard>
}
else
{
    <RadzenTabs TabPosition="TabPosition.Top" RenderMode="TabRenderMode.Client" class="profile-comments">
        <Tabs>
            <RadzenTabsItem Text="Comments">
                @if (_comments.Count() == 0)
                {
                    <p>@Loc["UserHasNoComments"]</p>
                }
                @*<RadzenDataList PageSize="5" WrapItems="false" AllowPaging="true" Data="@_comments" TItem="CommentModel" LoadData="@LoadData">*@
                <RadzenDataList WrapItems="false" AllowPaging="true" PageSize="3" Count="@_commentsCount" Data="@_comments" TItem="CommentModel" LoadData="@LoadData">
                    <Template Context="comment">
                        <div class="profile-comments__profile-box__date">
                            <i class="bi bi-calendar3"></i>
                            <span>@comment.DateCreated.LocalDateTime.ToString()</span>
                        </div>
                        <RadzenCard>
                            <div class="row">
                                <div class="profile-comments__profile-box col-md-8 text-truncate">
                                    <a @onclick="() => NavigateToProfile(comment.AuthorId)">
                                        <b class="profile-comments__profile-commented-link">@(comment.AuthorFirstName) @(comment.AuthorLastName)</b>
                                    </a>
                                </div>
                                <div class="col-md-4 text-right profile-comments__comment-options">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Primary">
                                        <StarComponent Value="@comment.RatingValue" />
                                    </RadzenBadge>
                                </div>
                            </div>
                            <div class="d-flex flex-row align-items-center profile-comments__content-box">
                                <RadzenImage Path="@comment.PhotoUrl" Class="rounded-circle float-left mr-3" Style="width: 80px; height: 80px;" />
                                <p class="profile-comments__content">
                                    @comment.Content
                                </p>
                            </div>
                        </RadzenCard>
                    </Template>
                </RadzenDataList>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

    @if (CurrentUserId != RecipientId && _currentUserCommented == false)
    {
        <CommentFormComponent AuthorId="@CurrentUserId" RecipientId="@RecipientId" OnPostedComment="OnPostedComment" />
    }
}

@code {

    [Parameter]
    public string RecipientId { get; set; }

    [Parameter]
    public string CurrentUserId { get; set; }

    private List<CommentModel> _comments = new();
    private int _commentsCount = 0;
    private bool _currentUserCommented = true;

    OnebrbApiResponse<ICollection<CommentResponseModel>> _commentsResponse;

    private string _updatedComment = string.Empty;

    private void NavigateToProfile(string id)
    {
        Navigation.NavigateTo($"/profiles/{id}");
    }

    protected override async Task OnParametersSetAsync()
    {
        _commentsResponse = await OnebrbApiClient.ApiUsersCommentsAsync(RecipientId, 5, 0);

        if (_commentsResponse.StatusCode == (int)HttpStatusCode.OK)
        {
            _comments = Mapper.Map<List<CommentModel>>(_commentsResponse.Result);

            // Get comments count
            var commentsCountResponse = await OnebrbApiClient.ApiUsersCommentsCountAsync(RecipientId);

            if (commentsCountResponse.StatusCode == (int)HttpStatusCode.OK)
            {
                _commentsCount = commentsCountResponse.Result.Count;
            }

            // Check if current user already commented
            var currentUserCommentedResponse = await OnebrbApiClient.ApiCommentsGetAsync(RecipientId, CurrentUserId);

            if (currentUserCommentedResponse.StatusCode == (int)HttpStatusCode.OK)
            {
                _currentUserCommented = currentUserCommentedResponse.Result.Any();
            }
        }
    }

    async Task LoadData(LoadDataArgs args)
    {
        var result = await OnebrbApiClient.ApiUsersCommentsAsync(CurrentUserId, args.Top.Value, args.Skip.Value);
        _comments = Mapper.Map<List<CommentModel>>(result.Result);
    }

    async Task OnPostedComment()
    {
        
    }
}
