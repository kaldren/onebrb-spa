@using Onebrb.SPA.Models
@using System.Linq
@using OnebrbApi

@inject NavigationManager Nav
@inject DialogService DialogService
@inject NavigationManager NavManager

@inject IOnebrbApiClient OnebrbApiClient
@if (ProductModels is null || !ProductModels.Any())
{
    <p>You don't have any products yet. Create one?</p>
}
else
{
<p>Items remaining: @ProductModels.Count</p>

    <div class="manage-products-component">
        <RadzenDataGrid @ref="productsGrid" AllowFiltering="false" AllowPaging="true" PageSize="5" AllowSorting="true"
                    Data="@ProductModels" TItem="ProductModel">
            <Columns>
                <RadzenDataGridColumn Width="150px" TItem="ProductModel" Title="#" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="product">
                        <div class="manage-products-component__options">

                            <button type="button" class="btn btn-primary" @onclick=@(args => @OnEditProductButtonClick(product)) title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            <button type="button" class="btn btn-danger" @onclick=@(args => OnDeleteProductButtonClick(product.Id)) title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ProductModel" Property="ProductModel.Title" Title="Product">
                    <Template Context="product">
                        <a href="products/@product.Id">
                            <RadzenImage Path="@product?.Images?.First()?.Path" style="width: 40px; height: 40px; border-radius: 8px; margin-right: 8px; float: left;" />
                            <h5 class="mt-1 mb-0">@product?.Title</h5>
                        </a>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ProductModel" Property="ProductModel.Price" Title="Price" />

                <RadzenDataGridColumn TItem="ProductModel" Property="ProductModel.Date" Title="Date Created" FormatString="{0:d}" />

            </Columns>
        </RadzenDataGrid>
    </div>
}


@code {

    [Parameter]
    public IList<ProductModel>? ProductModels { get; set; }

    RadzenDataGrid<ProductModel>? productsGrid;

    async Task OnDeleteProductButtonClick(string productId)
    {
        bool? confirm = await this.DialogService.Confirm("Are you sure you want to delete this product?", "Deleteing a product", new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (confirm is true)
        {
            await OnebrbApiClient.ProductsDELETEAsync(productId);
            ProductModel? removedProduct = ProductModels?.Where(p => p.Id == productId).SingleOrDefault();
            ProductModels?.Remove(removedProduct);

            productsGrid?.Reload();
        }
    }

    async Task OnEditProductButtonClick(ProductModel product)
    {
        var result = await DialogService.OpenAsync($"Edit {product.Title}", ds => 
    @<ProductEditComponent ProductModel="product" OnProductSave="ds.Close" OnProductCancel="ds.Close" />);
    }

    void OnChange(string value, string name)
    {

    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
}