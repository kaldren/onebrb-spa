@page "/products/new"
@using AutoMapper
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Onebrb.SPA.Models
@using OnebrbApi
@using System.Net

@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IAccessTokenProvider TokenProvider
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IConfiguration configuration

<PageTitle>New product</PageTitle>

<h3>New product</h3>

@if (ProductModel is null)
{
    <p>Loading...</p>
}
else
{
    <div class="newproduct-page">
        <div class="newproduct-page__form">
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Short and descriptive title (max 50 characters)</RadzenText>
                <RadzenTextBox Change=@(args => OnProductTitleChange(args, "TextBox")) Value="@ProductModel.Title" Placeholder="Title" class="newproduct-page__input basic-input" />
            </RadzenCard>

            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Describe what you are selling (max 250 characters)</RadzenText>
                <RadzenTextArea Change=@(args => OnProductDescriptionChange(args, "TextBox")) Value="@ProductModel.Description" Placeholder="Description" class="newproduct-page__textarea basic-textarea" />
            </RadzenCard>

            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Price (leave as is if it's negotiable)</RadzenText>
                <RadzenNumeric TValue="decimal" Format="c" Value="@ProductModel.Price" Change="@(args => OnProductPriceChange(args, "Formatted numeric"))" class="newproduct-page__input basic-input" />
            </RadzenCard>

            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Upload between one and six photos</RadzenText>
                <RadzenUpload 
                            @ref="upload" 
                            Auto="false" 
                            Multiple="true" 
                            Change=@(args => OnChange(args))
                            class="w-100 file-upload" 
                        />
                <RadzenButton Text="Upload" Click=@(args => OnProductSaveClick()) Visible="@(hasFiles)" class="d-block mt-4" />
            </RadzenCard>
        </div>
    </div>
}


@code {
    RadzenUpload? upload;

    bool hasFiles = false;
    string newProductId = string.Empty;

    public ProductModel ProductModel { get; } = new();

    protected async override Task OnInitializedAsync()
    {
    }

    void OnProductTitleChange(string value, string name)
    => ProductModel.Title = value;

    void OnProductDescriptionChange(string value, string name)
        => ProductModel.Description = value;

    void OnProductPriceChange(decimal value, string name)
        => ProductModel.Price = value;

    async void OnChange(UploadChangeEventArgs args)
    {
        hasFiles = args.Files.Count() != 0;
    }

    async Task PostImages(string productId)
    {
        var tokenResult = await TokenProvider.RequestAccessToken();

        if (tokenResult.TryGetToken(out var token))
        {
            var currentUserResponse = await OnebrbApiClient.ApiUsersCurrentAsync();

            upload.GetHeaders().Add("Authorization", $"Bearer {token.Value}");
            upload.Url = $"{configuration["AppConfiguration:OnebrbAPIEndpoint"]}/images/{productId}";
            await upload.Upload();

            // Check if images are uploaded
            var countResponse = await OnebrbApiClient.ApiProductsImagesCountAsync(productId);

            if (countResponse.StatusCode == (int)HttpStatusCode.OK && countResponse.Result > 0) 
            {
                ToastService.ShowSuccess("The product has been created.");
            }
            else 
            {
                ToastService.ShowError("Sorry, we couldn't save your images. The product is created but not visible to others.");
            }
        }
    }

    async Task OnProductSaveClick()
    {
        // Create product
        bool productCreated = false;
        ProductPostRequestModel newProductModel = Mapper.Map<ProductPostRequestModel>(ProductModel);
        var newProductResponse = await OnebrbApiClient.ApiProductsPostAsync(newProductModel);


        if (newProductResponse.StatusCode == (int)HttpStatusCode.OK)
        {
            productCreated = true;
            await PostImages(newProductResponse.Result.Id);
        }
        else
        {
            ToastService.ShowError("Sorry, we couldn't create your product. Please try again later.");
        }

        if (productCreated) 
        {
            Nav.NavigateTo($"products/{newProductResponse.Result.Id}");
        }
    }
}
