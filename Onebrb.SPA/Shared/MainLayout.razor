@inherits LayoutComponentBase
@using Onebrb.SPA.Pages
@using Onebrb.SPA.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Blazored.Toast.Configuration
@using OnebrbApi
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

@inject IWebAssemblyHostEnvironment environment
@inject IToastService toastService
@inject IStringLocalizer<Pages.Home.Shared.Shared> Loc


<div class="page">
    <RadzenDialog />
    <SignalRNotifications />

    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
                <footer>
                    Onebrb &copy; - All rights reserved
                </footer>
            </div>
        </Authorized>
    </AuthorizeView>

    <main>
        <div class="top-row px-4 auth">
            <LanguageSelector />
            <LoginDisplay />
        </div>

        <article class="content px-4">
            <CustomErrorBoundry @ref="_errorBoundry">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="Exception">
                    @{
                        toastService.ClearAll();
                        toastService.ShowError($"{@Loc["ErrorGenericMessage"]}");
                    }
                </ErrorContent>
            </CustomErrorBoundry>
        </article>
    </main>
</div>

@code {
    private CustomErrorBoundry _errorBoundry;

    protected override void OnInitialized()
    {
        _errorBoundry = new CustomErrorBoundry();
    }
}