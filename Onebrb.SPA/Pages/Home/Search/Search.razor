@page "/search"

@using System.Globalization
@using AutoMapper;
@using Onebrb.SPA.Models
@using Onebrb.SPA.Shared.Components
@using OnebrbApi;
@using System.Net;

@inject NavigationManager Nav
@inject IStringLocalizer<Search> Localizer
@inject IStringLocalizer<Shared.Shared> LocalizerShared
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IToastService ToastService

<PageTitle>@Localizer["SearchPageTitle"]</PageTitle>

<div class="SearchComponent">
    <div>
        <RadzenCard>
            <h4 class="mb-4">@LocalizerShared["Search"]</h4>
            <RadzenTextBox Placeholder=@LocalizerShared["SearchNamePlaceholder"] Change=@(args => OnNameSearchChange(args, "TextBox")) Class="w-100" />
        </RadzenCard>
    </div>

    <div>
        <RadzenButton Click=@OnClick Text="Search" class="SearchComponent__search-btn" Disabled=@(string.IsNullOrWhiteSpace(fullName) || (!string.IsNullOrWhiteSpace(fullName) && searchBtnClicked)) />
    </div>


    <div class="search-data">
        @if (profiles is null && searchBtnClicked)
        {
            if (statusCodeEnum is null)
            {
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">@LocalizerShared["Loading"]</RadzenText>
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                </RadzenCard>
            }
            else
            {
                <ErrorComponent StatusCode="statusCodeEnum.Value" />
            }
        }

        @if (profiles is not null)
        {
            <RadzenDataList WrapItems="true" AllowPaging="false" Data="@profiles" TItem="UserProfileModel">
                <Template Context="data">
                    <RadzenCard Style="width:300px;">
                        <div class="d-flex flex-row align-items-center">
                            <a href="/users/@data.Id">
                                <RadzenImage Path="@(data.Photo ?? _defaultPhotoUrl)" Class="rounded-circle float-start me-3" Style="width: 80px; height: 80px;" />
                            </a>
                            <div>
                                <h4 class="mb-0">@(data?.FirstName + " " + data?.LastName)</h4>
                                <div>@data?.OccupationName</div>
                                <div style="font-size: .8em">@(data.Country)</div>
                            </div>
                        </div>
                        <hr style="border: none; background-color: rgba(0,0,0,.08); height: 1px; margin: 1rem 0;" />
                        <div class="row">
                            @if (data.Rating is not null)
                            {
                                <div class="col-md-4 text-end">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text=@(data.Rating.ToString()) />
                                </div>
                            }
                        </div>
                    </RadzenCard>
                </Template>
            </RadzenDataList>
            <RadzenPager ShowPagingSummary="true" PagingSummaryFormat="@pagingSummaryFormat" AlwaysVisible="true" HorizontalAlign="HorizontalAlign.Right" Count=@_profilesCount PageSize=@pageSize PageNumbersCount="5" PageChanged="@OnPageChanged" />
        }
    </div>
</div>

@code {
    //TODO: Search model
    private string? fullName;
    private bool searchBtnClicked = false;
    private string? _defaultPhotoUrl = "img/no-photo.svg";

    private HttpResponseMessage? res;
    private IEnumerable<UserProfileModel>? profiles;
    private ResponseStatusCodeEnum? statusCodeEnum;

    private string pagingSummaryFormat = "Displaying page {0} of {1} (total {2} records)";
    private int _profilesCount = 0;
    private int pageSize = 5;

    void OnNameSearchChange(string value, string name)
    {
        fullName = value;
    }

    async Task OnPageChanged(PagerEventArgs args)
    {
        await GetProfilesAsync(args.Top, args.Skip);
    }

    void OnRowClick(DataGridRowMouseEventArgs<UserProfileModel> selectedProfile)
    {
        Nav.NavigateTo($"users/{selectedProfile.Data.Id}");
    }

    async Task OnClick()
    {
        searchBtnClicked = true;

        await GetProfilesAsync();

        searchBtnClicked = false;
    }

    async Task GetProfilesAsync(int top = 5, int skip = 0)
    {
        try
        {
            var searchCountResponse = await OnebrbApiClient.ApiSearchCountAsync(fullName);
            var profilesResponse = await OnebrbApiClient.ApiSearchAsync(fullName, top, skip);

            profiles = Mapper.Map<IEnumerable<UserProfileModel>>(profilesResponse.Result);
            _profilesCount = searchCountResponse.Result.Count;
        }
        catch (ApiException<ProblemDetails> ex)
        {
            ToastService.ClearAll();

            if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
            {
                statusCodeEnum = ResponseStatusCodeEnum.Unauthorized;
                ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
            }
            if (ex.StatusCode == (int)HttpStatusCode.NotFound)
            {
                statusCodeEnum = ResponseStatusCodeEnum.NotFound;
                ToastService.ShowError(@Localizer["UserNotFound"]);
            }
        }
        catch (Exception ex)
        {
            statusCodeEnum = ResponseStatusCodeEnum.ServerError;
            ToastService.ShowError(@LocalizerShared["ErrorGenericMessage"]);
        }
    }
}
