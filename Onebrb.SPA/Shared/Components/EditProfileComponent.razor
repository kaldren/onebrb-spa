@using AutoMapper
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Onebrb.SPA.Models
@using System.Security.Claims
@using System.Net
@using System.Text.Json
@using Onebrb.SPA.Shared.Components
@using OnebrbApi

@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IToastService ToastService

@if (_updatedUserProfile)
{
    ToastService.ClearAll();
    ToastService.ShowSuccess("Profile updated successfully.");
}

@if (_updateUserProfileError)
{
    ToastService.ClearAll();
    ToastService.ShowError("Error occured, please try again later.");
}

@if (@CurrentUser is null && _occupations is null)
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Loading profile...</RadzenText>
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenCard>
}
else
{
    <div class="settings-component">
        <RadzenTemplateForm Data="CurrentUser">
            <div class="row">
                <div class="settings-component__form col-md-6">
                    <div class="row">
                        <div class="settings-component__form__input-div col-md-8">
                            <RadzenTextBox style="width: 100%;" Name="First Name" @bind-Value="@CurrentUser.FirstName" />
                        </div>
                        <div class="settings-component__form__input-div col-md-8">
                            <RadzenTextBox style="width: 100%;" Name="Last Name" @bind-Value="@CurrentUser.LastName" />
                        </div>
                        <div class="settings-component__form__input-div col-md-8">
                            <RadzenTextBox style="width: 100%;" Name="Email" @bind-Value="@CurrentUser.Email" />
                            <RadzenCard>
                                <p>Who can see my email?</p>
                                <RadzenSelectBar Size="ButtonSize.Small" @bind-Value=@CurrentUser.IsEmailVisible TValue="bool" Change=@(args => OnEmailPrivacyChange(args, "SelectBar with single selection"))>
                                    <Items>
                                        <RadzenSelectBarItem Text="Everyone" Value="true" />
                                        <RadzenSelectBarItem Text="Only me" Value="false" />
                                    </Items>
                                </RadzenSelectBar>
                            </RadzenCard>
                        </div>
                        <div class="settings-component__form__input-div col-md-8">
                            <RadzenTextBox style="width: 100%;" Name="Phone" @bind-Value="@CurrentUser.Phone" />
                            <RadzenCard>
                                <p>Who can see my phone number?</p>
                                <RadzenSelectBar Size="ButtonSize.Small" @bind-Value=@CurrentUser.IsPhoneVisible TValue="bool" Change=@(args => OnPhonePrivacyChange(args, "SelectBar with single selection"))>
                                    <Items>
                                        <RadzenSelectBarItem Text="Everyone" Value="true" />
                                        <RadzenSelectBarItem Text="Only me" Value="false" />
                                    </Items>
                                </RadzenSelectBar>
                            </RadzenCard>

                        </div>

                        <div class="settings-component__form__input-div col-md-8">
                            <RadzenCard>
                                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Occupation</RadzenText>
                                <RadzenDropDown AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data=@_occupations @bind-Value=@_userOccupation.Name
                                            TextProperty="Name" ValueProperty="Name" Change=@(args => OnOccupationChange(args)) Class="w-100" />
                            </RadzenCard>
                        </div>

                        <div class="settings-component__form__input-div col-md-8">
                            <RadzenCard>
                                <h4 class="mb-4">About</h4>
                                <RadzenTextArea Class="w-100" @bind-Value="@CurrentUser.About" />
                            </RadzenCard>
                        </div>

                        <div class="settings-component__social">
                            <div class="settings-component__form__input-div col-md-8">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-linkedin" viewBox="0 0 16 16">
                                    <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z" />
                                </svg>
                                <RadzenTextBox style="width: 100%;" Name="LinkedIn account" @bind-Value="@CurrentUser.LinkedInProfile" />
                            </div>

                            <div class="settings-component__form__input-div col-md-8">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-facebook" viewBox="0 0 16 16">
                                    <path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951z" />
                                </svg>
                                <RadzenTextBox style="width: 100%;" Name="Facebook account" @bind-Value="@CurrentUser.FacebookProfile" />
                            </div>

                            <div class="settings-component__form__input-div col-md-8">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-instagram" viewBox="0 0 16 16">
                                    <path d="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.917 3.917 0 0 0-1.417.923A3.927 3.927 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.916 3.916 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.926 3.926 0 0 0-.923-1.417A3.911 3.911 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0h.003zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599.28.28.453.546.598.92.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.47 2.47 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.478 2.478 0 0 1-.92-.598 2.48 2.48 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233 0-2.136.008-2.388.046-3.231.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92.28-.28.546-.453.92-.598.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045v.002zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92zm-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217zm0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334z" />
                                </svg>
                                <RadzenTextBox style="width: 100%;" Name="Instagram account" @bind-Value="@CurrentUser.InstagramProfile" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-12 d-flex" style="margin-top: 16px;">
                    <RadzenButton ButtonType="ButtonType.Submit" Click=@(args => OnUpdateProfileClick()) Icon="save" Text="Save" />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text="Cancel" Click="@Cancel" />
                </div>
            </div>
        </RadzenTemplateForm>
    </div>
}


@code {
    [Parameter]
    public UserProfileModel? CurrentUser { get; set; }

    public ICollection<OccupationModel>? _occupations;

    public OccupationModel _userOccupation = new();

    private bool _updatedUserProfile = false;
    private bool _updateUserProfileError = false;

    IEnumerable<int> values = new int[] { 1, 2 };

    protected override async Task OnInitializedAsync()
    {
        var occupationsResponse = await OnebrbApiClient.ApiOccupationsAsync();

        if (occupationsResponse.StatusCode == (int)HttpStatusCode.OK)
        {
            _occupations = Mapper.Map<ICollection<OccupationModel>>(occupationsResponse.Result);

            // Get current user's occupation
            var currentUserOccupationResponse = await OnebrbApiClient.ApiUsersOccupationAsync(CurrentUser.Id);

            if (currentUserOccupationResponse.StatusCode == (int)HttpStatusCode.OK)
            {
                _userOccupation = Mapper.Map<OccupationModel>(currentUserOccupationResponse.Result);
            }
        }
    }

    void OnOccupationChange(object value)
    {
        CurrentUser.OccupationName = _userOccupation.Name;
        var str = value is IEnumerable<object> ? string.Join(", ", (IEnumerable<object>)value) : value;
    }

    void OnEmailPrivacyChange(object value, string name)
    {
        var str = value is IEnumerable<int> ? string.Join(", ", (IEnumerable<int>)value) : value;
    }

    void OnPhonePrivacyChange(object value, string name)
    {
        var str = value is IEnumerable<int> ? string.Join(", ", (IEnumerable<int>)value) : value;
    }

    async Task OnUpdateProfileClick()
    {
        var model = Mapper.Map<UpdateUserProfileRequestModel>(CurrentUser);

        var updateUserResponse = await OnebrbApiClient.ApiUsersPatchAsync(model);

        if (updateUserResponse.StatusCode == (int)HttpStatusCode.OK)
        {
            CurrentUser = Mapper.Map<UserProfileModel>(updateUserResponse.Result);
        }

        if (CurrentUser is not null)
            _updatedUserProfile = true;
        else
            _updateUserProfileError = true;
    }

    void Cancel()
    {
        //
    }
}
