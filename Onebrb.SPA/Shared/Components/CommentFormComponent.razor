@using AutoMapper
@using Onebrb.SPA.Models
@using OnebrbApi
@using System.Net
@using System.Text.RegularExpressions;

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject DialogService DialogService
@implements IDisposable
@inject IToastService ToastService

@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared

<div class="comment-form-component">
    <h2>@LocalizerShared["CommentForm_AddComment"]</h2>
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">@LocalizerShared["CommentForm_RatingFiveStars"]</RadzenText>
        <RadzenRating Change=@(args => OnRatingChange(args)) />
    </RadzenCard>
    <TextAreaComponent OnChange="ChangeHandler" />
    <RadzenButton Disabled=@(_rating < 1 || string.IsNullOrWhiteSpace(_comment)) Text="Post" Click="OnCommentSubmit" />

    @if (showConfirmDialog)
    {
        <RadzenCard>
            <RadzenButton Text=@LocalizerShared["CommentForm_PostConfirmationDialogTitle"] Style="width: 100%;" ButtonStyle="ButtonStyle.Secondary" Click=@(args => DialogService.Confirm(@LocalizerShared["CommentForm_PostConfirmation"], @LocalizerShared["CommentForm_PostConfirmationTitle"], new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" })) />
        </RadzenCard>
    }

</div>

@code {
    [Parameter]
    public string RecipientId { get; set; }

    [Parameter]
    public string AuthorId { get; set; }

    [Parameter] public EventCallback OnPostedComment { get; set; }

    private int _rating;
    private string _comment = string.Empty;
    private bool showConfirmDialog = false;

    void OnRatingChange(int value)
        => _rating = value;

    async Task OnCommentSubmit()
    {
        var urlRegex = new Regex(@"((?:(?:http|ftp|ws)s?|sftp):\/\/?)?([^:/\s.#?]+\.[^:/\s#?]+|localhost)(:\d+)?((?:\/\w+)*\/)?([\w\-.]+[^#?\s]+)?([^#]+)?(#[\w-]*)?");

        if (urlRegex.IsMatch(_comment))
        {
            await DialogService.OpenAsync("Comment error", ds =>
            @<div>
                The comment cannot contain any urls / website links.
                </div>
            , new DialogOptions() { CloseDialogOnOverlayClick = true });
            return;
        }

        bool? continueComment = await DialogService.Confirm(@LocalizerShared["CommentForm_PostConfirmation"], @LocalizerShared["CommentForm_PostConfirmationTitle"], new ConfirmOptions() { OkButtonText = @LocalizerShared["Yes"], CancelButtonText = @LocalizerShared["No"] });

        if (continueComment is true)
        {
            // Call API to create the new comment
            var comment = new PostCommentRequestModel
                {
                    AuthorId = AuthorId,
                    RecipientId = RecipientId,
                    Content = _comment,
                    Rating = _rating
                };

            try
            {
                var result = await OnebrbApiClient.ApiCommentsPostAsync(comment);

                if (result.StatusCode == (int)HttpStatusCode.OK)
                {
                    var commentModel = Mapper.Map<CommentModel>(result.Result);
                    await OnPostedComment.InvokeAsync(commentModel);
                }
            }
            catch (ApiException<ProblemDetails> ex)
            {
                ToastService.ClearAll();

                if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
                {
                    ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
                }
                if (ex.StatusCode == (int)HttpStatusCode.NotFound)
                {
                    ToastService.ShowError(@LocalizerShared["UserNotFound"]);
                }
            }
            catch (Exception)
            {
                ToastService.ShowError(@LocalizerShared["ErrorGenericMessage"]);
            }
        }
    }

    void ChangeHandler(string message)
    {
        _comment = message;
    }

    void Open(string title, Type type, Dictionary<string, object> parameters, DialogOptions options)
    {
    }

    void Close(dynamic result)
    {
    }

    public void Dispose()
    {
        DialogService.OnOpen -= Open;
        DialogService.OnClose -= Close;
    }
}
