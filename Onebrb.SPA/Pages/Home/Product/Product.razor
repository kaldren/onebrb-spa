@page "/products/{Id}"

@using AutoMapper
@using Onebrb.SPA.Models
@using Onebrb.SPA.Shared.Components
@using OnebrbApi
@using System.Net

@inject DialogService DialogService
@implements IDisposable

@inject IStringLocalizer<Onebrb.SPA.Pages.Home.Profile.Profile> Loc
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper

<PageTitle>Product</PageTitle>

<div class="product-page">
    @if (_product is null)
    {
        <p>Product not found.</p>
    }
    else
    {
        @if (!_product.IsActive)
        {
            <NotificationBarComponent>
                <i class="bi bi-exclamation-triangle"></i>
                <p>Your product is currently visible only by you. Activate it to make it public.</p>
                <RadzenButton ButtonStyle="ButtonStyle.Primary" Text="Activate" />
            </NotificationBarComponent>
        }

        <div class="product-page__seller-info">
            <ProfileProductComponent CurrentUser="_currentUser" ProfileModel="_profile" />
        </div>

        <div class="product-page__product-info">

            <div class="product-info__product-header">
                <h2>@_product.Title</h2>
            </div>

            <div class="product-info__gallery">

                <div class="gallery__main-photo">
                    <RadzenImage Path="@_product.Images?.FirstOrDefault()?.Path">
                    </RadzenImage>
                </div>

                <div class="product-info__description">
                    <span>
                        @_product.Description
                    </span>
                </div>

                <div class="gallery__images">
                    @for (int i = 0; i < @_product.Images?.Count; i++)
                    {
                        string imgPath = @_product.Images.ElementAt(i).Path;

                        <div class="images__product_image">
                            <RadzenCard>
                                <RadzenImage Path="@imgPath"
                                     Click="@ShowCloseableFromOverlayDialog">
                                </RadzenImage>
                            </RadzenCard>
                        </div>
                    }

                </div>

            </div>

            <div class="product-info__action-btns">
                <ButtonComponent Text="I'm interested" OnClick=@OnInterestedClicked />
            </div>

        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; }

    private ProductModel _product;

    private UserProfileModel? _currentUser = new()
            {
                Id = "4f170031-f087-4ad5-8343-7da89e8cb8bd",
                FirstName = "Kaloyan",
                LastName = "Drenski"
            };
    private UserProfileModel? _profile;

    protected async override Task OnInitializedAsync()
    {
        OnebrbApiResponse<ProductResponseModel> response = await OnebrbApiClient.ApiProductsGetAsync(Id);
        var profileResponse = await OnebrbApiClient.ApiUsersGetAsync(response.Result.ProfileId);

        _profile = Mapper.Map<UserProfileModel>(profileResponse.Result);

        if (response.StatusCode == (int)HttpStatusCode.OK)
        {
            _product = Mapper.Map<ProductModel>(response.Result);
        }
    }


    async Task ShowCloseableFromOverlayDialog()
    {
        await DialogService.OpenAsync("", ds =>
    @<div>
        <RadzenImage Path="https://automedia.investor.bg/media/files/resized/uploadedfiles/640x0/306/7ea7096ab1efa8cd5d823a7ea8a4b306-tesla-model-s-2022-update-2.jpg">
        </RadzenImage>
        </div>
    , new DialogOptions() { CloseDialogOnOverlayClick = true });
    }

    public void Dispose()
    {
        // The DialogService is a singleton so it is advisable to unsubscribe.
        DialogService.OnOpen -= Open;
        DialogService.OnClose -= Close;
    }

    void Open(string title, Type type, Dictionary<string, object> parameters, DialogOptions options)
    {
    }

    void Close(dynamic result)
    {
    }

    async Task OnInterestedClicked()
    {
        // Send interested to queue
        await OnebrbApiClient.ApiProductsPutAsync();

        // Azure function sends notification to user (need to add globe icon with number of notifications)
    }
}
