@inherits LayoutComponentBase
@using Onebrb.SPA.Pages
@using Onebrb.SPA.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Blazored.Toast.Configuration
@using OnebrbApi
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

@inject IWebAssemblyHostEnvironment environment
@inject IToastService toastService
@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="page">
    <RadzenDialog />
    <AuthorizeView>
        <Authorized>
            <SignalRNotificationsComponent />

            <div class="sidebar">
                <NavMenu />
                <footer>
                    @LocalizerShared["AllRightsReserved"]
                </footer>
            </div>
        </Authorized>
    </AuthorizeView>

    <main>
        <div class="top-row auth">
            <AuthorizeView>
                <Authorized>
                    <HiUserComponent />
                    @*<NotificationAlertComponent />*@
                </Authorized>
            </AuthorizeView>

            <LanguageSelector />
            <LoginDisplay />
        </div>

        <AuthorizeView>
            <Authorized>
                <article class="content auth">
                    <div class="content__inner">
                        <CustomErrorBoundry @ref="_errorBoundry">
                            <ChildContent>
                                @Body
                            </ChildContent>
                            <ErrorContent Context="ex">
                                @{
                                    //if (ex is ApiException<ProblemDetails>)
                                    //{
                                    //    toastService.ShowError(ex.Message);
                                    //}
                                    //else
                                    //{
                                    //    toastService.ShowError($"{@Loc["ErrorGenericMessage"]}");
                                    //}
                                    //ex
                                    //toastService.ClearAll();
                                    //
                                }
                                <ErrorComponent />
                            </ErrorContent>
                        </CustomErrorBoundry>
                    </div>
                </article>
            </Authorized>
            <NotAuthorized>
                <article class="content">
                    <div class="content__inner">
                        <CustomErrorBoundry @ref="_errorBoundry">
                            <ChildContent>
                                @Body
                            </ChildContent>
                            <ErrorContent Context="ex">
                                @{
                                    //if (ex is ApiException<ProblemDetails>)
                                    //{
                                    //    toastService.ShowError(ex.Message);
                                    //}
                                    //else
                                    //{
                                    //    toastService.ShowError($"{@Loc["ErrorGenericMessage"]}");
                                    //}
                                    //ex
                                    //toastService.ClearAll();
                                    //
                                }
                                <ErrorComponent />
                            </ErrorContent>
                        </CustomErrorBoundry>
                    </div>
                </article>
            </NotAuthorized>
        </AuthorizeView>

        <FooterMenuComponent />
    </main>
</div>

@code {
    private CustomErrorBoundry _errorBoundry;
    private bool _isAuthenticated = false;

    protected override void OnInitialized()
    {
        _errorBoundry = new CustomErrorBoundry();
    }
}