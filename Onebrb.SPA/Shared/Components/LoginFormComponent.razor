@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared
@inject IJSRuntime JS
@inject DialogService DialogService
@implements IDisposable
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="LoginFormComponent">
    <RadzenCard>
        <div class="LoginFormComponent__social">
            <RadzenIcon Icon="login" class="login_icon" />
            <a href=@_signInUrl>
                <RadzenButton Text=@LocalizerShared["LoginToOnebrb"] ButtonStyle="ButtonStyle.Primary" />
            </a>
        </div>
    </RadzenCard>
</div>

@code {
    private bool _isValidBrowser;
    private string _signInUrl = "authentication/login";

    public void Dispose()
    {
        DialogService.OnOpen -= Open;
        DialogService.OnClose -= Close;
    }

    protected override async Task OnInitializedAsync()
    {
        _isValidBrowser = await JS.InvokeAsync<bool>("isValidBrowser.get");

        if (!_isValidBrowser)
            _signInUrl = "javascript:void(0)";
    }

    private async Task onSignInClick()
    {
        if (!_isValidBrowser)
        {
            await DialogService.OpenAsync("Invalid browser", ds =>
            @<div>
                You are using embedded or outdated browser. Please use Chrome, Edge, Firefox or Safari.
        </div>
    , new DialogOptions() { CloseDialogOnOverlayClick = true });
            return;
        }
    }

    private void Open(string title, Type type, Dictionary<string, object> parameters, DialogOptions options)
    {
    }

    private void Close(dynamic result)
    {
    }
}