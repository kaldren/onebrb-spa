@page "/"

@using AutoMapper
@using Onebrb.SPA.Models
@using Onebrb.SPA.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared

<PageTitle>@LocalizerShared["IndexPageTitle"]</PageTitle>

<AuthorizeView>
    <Authorized>
        <ProfileComponent />
    </Authorized>
    <NotAuthorized>
        <WelcomeComponent />
    </NotAuthorized>
</AuthorizeView>