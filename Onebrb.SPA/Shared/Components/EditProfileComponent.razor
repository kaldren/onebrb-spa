@using AutoMapper
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Onebrb.SPA.Models
@using System.Security.Claims
@using System.Net
@using System.Text.Json
@using Onebrb.SPA.Shared.Components
@using OnebrbApi
@using System.Text.RegularExpressions;
@using System.Diagnostics.CodeAnalysis;

@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IToastService ToastService

@inject IStringLocalizer<Pages.Home.Profile.Profile> LocalizerProfile
@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared

@inject DialogService DialogService

@inject NavigationManager Navigation
@inject SignOutSessionStateManager SignOutManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IAccessTokenProvider _tokenProvider
@implements IDisposable

@if (_updatedUserProfile)
{
    ToastService.ClearAll();
    ToastService.ShowSuccess(@LocalizerProfile["EditProfile_UpdatedSuccessfully"]);
}

@if (_updateUserProfileError)
{
    ToastService.ClearAll();
    ToastService.ShowError(@LocalizerShared["EditProfile_NotUpdatedSuccessfully"]);
}
<div class="EditProfileComponent">
    @if (@CurrentUser is null)
    {
        <RadzenCard>
            <p>@LocalizerShared["Loading"]</p>
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </RadzenCard>
    }
    else
    {
        <RadzenTemplateForm Data="CurrentUser">
            <div class="row">
                <div class="EditProfileComponent__form">
                    <div class="row">

                        <div class="EditProfileComponent__form__input-div">
                            <RadzenCard>
                                <p>@LocalizerProfile["EditProfile_ProfilePhoto"]</p>
                                <RadzenUpload @ref="upload"
                                              Accept="image/*" 
                                              Auto="false" 
                                              Url=@userPhotoEndpoint 
                                              Change=OnChange
                                              Progress=OnProgress class="w-100">
                                    <RadzenUploadHeader Name="Authorization" Value=@_token />
                                </RadzenUpload>
                                <RadzenButton Text="Upload" Click=@(args => upload?.Upload()) Disabled=_isUploadPhotoBtnDisabled class="d-block mt-4" />
                            </RadzenCard>
                        </div>

                        <div class="EditProfileComponent__form__input-div">
                            <RadzenTextBox style="width: 100%;" Name=@LocalizerProfile["EditProfile_FirstName"] Placeholder=@LocalizerProfile["EditProfile_FirstName"] @bind-Value="@CurrentUser.FirstName" MaxLength="@ValidationConstants.FirstNameMaxLength" />
                        </div>
                        <div class="EditProfileComponent__form__input-div">
                            <RadzenTextBox style="width: 100%;" Name=@LocalizerProfile["EditProfile_LastName"] Placeholder=@LocalizerProfile["EditProfile_LastName"] @bind-Value="@CurrentUser.LastName" MaxLength="@ValidationConstants.LastNameMaxLength" />
                        </div>
                        <div class="EditProfileComponent__form__input-div">
                            <RadzenTextBox style="width: 100%;" Name=@LocalizerProfile["EditProfile_Email"] Placeholder=@LocalizerProfile["EditProfile_Email"] @bind-Value="@CurrentUser.Email" Disabled />
                            <RadzenCard class="EditProfileComponent__form__privacy-toggle">
                                <div class="privacy-toggle__lock">
                                    <i class="bi bi-file-lock2-fill"></i>
                                </div>
                                <RadzenSelectBar Size="ButtonSize.Small" @bind-Value=@CurrentUser.IsEmailVisible TValue="bool" Change=@(args => OnEmailPrivacyChange(args))>
                                    <Items>
                                        <RadzenSelectBarItem Text=@LocalizerProfile["EditProfile_PrivacyEveryone"] Value="true" />
                                        <RadzenSelectBarItem Text=@LocalizerProfile["EditProfile_PrivacyOnlyMe"] Value="false" />
                                    </Items>
                                </RadzenSelectBar>
                            </RadzenCard>
                        </div>

                        @*TODO: Phone validation - until then not showing phones*@
                        @*                        <div class="EditProfileComponent__form__input-div">
                    <RadzenTextBox style="width: 100%;" Name="Phone" Placeholder="Phone number" @bind-Value="@CurrentUser.Phone" MaxLength="@_phoneMaxLength" />
                    <RadzenCard class="EditProfileComponent__form__privacy-toggle" Visible=(!string.IsNullOrWhiteSpace(CurrentUser.Phone))>
                    <div class="privacy-toggle__lock">
                    <i class="bi bi-file-lock2-fill"></i>
                    </div>
                    <RadzenSelectBar Size="ButtonSize.Small" @bind-Value=@CurrentUser.IsPhoneVisible TValue="bool?" Change=@(args => OnPhonePrivacyChange(args))>
                    <Items>
                    <RadzenSelectBarItem Text="Everyone" Value="true" />
                    <RadzenSelectBarItem Text="Only me" Value="false" />
                    </Items>
                    </RadzenSelectBar>
                    </RadzenCard>
                    </div>*@

                        <div class="EditProfileComponent__form__input-div">
                            <RadzenCard>
                                <p>@LocalizerProfile["EditProfile_Occupation"]</p>
                                <RadzenDropDown AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Data=@_occupations @bind-Value=@CurrentUser.OccupationId
                                            TextProperty="Name" ValueProperty="Id" Change=@(args => OnOccupationChange(args)) Class="w-100" />
                            </RadzenCard>
                        </div>

                        <div class="EditProfileComponent__form__input-div">
                            <RadzenCard>
                                <h4 class="mb-4">@LocalizerProfile["EditProfile_About"]</h4>
                                <RadzenTextArea Class="w-100" @bind-Value="@CurrentUser.About" Name="aboutTextarea" Placeholder=@LocalizerProfile["EditProfile_AboutWriteSomething"] MaxLength="@ValidationConstants.AboutMaxLength" />
                                <span>(@string.Format(@LocalizerProfile["EditProfile_AboutMaxLength"], ValidationConstants.AboutMaxLength))</span>
                            </RadzenCard>
                        </div>

                        <div class="EditProfileComponent__social">
                            <div class="EditProfileComponent__form__input-div">
                                <i class="bi bi-linkedin"></i>
                                <RadzenTextBox style="width: 100%;" Name=@LocalizerProfile["EditProfile_LinkedInAccount"] Placeholder=@LocalizerProfile["EditProfile_LinkedInAccount"] @bind-Value="@CurrentUser.LinkedInProfile" MaxLength=ValidationConstants.SocialAccountMaxLength />
                            </div>

                            <div class="EditProfileComponent__form__input-div">
                                <i class="bi bi-facebook"></i>
                                <RadzenTextBox style="width: 100%;" Name=@LocalizerProfile["EditProfile_FacebookAccount"] Placeholder=@LocalizerProfile["EditProfile_FacebookAccount"] @bind-Value="@CurrentUser.FacebookProfile" MaxLength=ValidationConstants.SocialAccountMaxLength />
                            </div>

                            <div class="EditProfileComponent__form__input-div">
                                <i class="bi bi-instagram"></i>
                                <RadzenTextBox style="width: 100%;" Name=@LocalizerProfile["EditProfile_InstagramAccount"] Placeholder=@LocalizerProfile["EditProfile_InstagramAccount"] @bind-Value="@CurrentUser.InstagramProfile" MaxLength=ValidationConstants.SocialAccountMaxLength />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row justify-content-center">
                <div class="col-md-12 d-flex" style="margin-top: 16px;">
                    <RadzenButton ButtonType="ButtonType.Submit" Click=@(args => OnUpdateProfileClick()) Icon="save" Text=@LocalizerShared["Save"] Disabled=@_isUpdateBtnClicked />
                    <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="cancel" style="display: inline-block; margin-left: 10px;" Text=@LocalizerShared["Cancel"] Click="@Cancel" Disabled=@_isUpdateBtnClicked />
                </div>
                <div class="col-md-12 d-flex" style="margin-top: 16px;">
                    <RadzenButton ButtonType="ButtonType.Submit" Click=@(args => OnDeleteProfileClick()) class="btn-danger" Icon="delete_forever" Text=@LocalizerProfile["EditProfile_DeleteProfileButton"] Disabled=@_isDeleteBtnClicked />
                </div>
            </div>
        </RadzenTemplateForm>
    }
</div>

@code {
    [Parameter]
    public UserProfileModel? CurrentUser { get; set; }

    public ICollection<OccupationModel>? _occupations;

    public OccupationModel _userOccupation = new();
    RadzenUpload? upload;

    private string? _token;
    private string? userPhotoEndpoint;
    private const int MaxFileSizeInBytes = 2_000_000; // 2MB
    private bool _updatedUserProfile = false;
    private bool _isUpdateBtnClicked = false;
    private bool _isDeleteBtnClicked = false;
    private bool _updateUserProfileError = false;
    private bool _isUploadPhotoBtnDisabled = true;
    private string[] allowedImageFormats = new []{ ".jpg", ".jpeg", ".png" };

    // Cache this so it's created once (per David Fowler)
    private Regex urlRegex = new Regex(@"((?:(?:http|ftp|ws)s?|sftp):\/\/?)?([^:/\s.#?]+\.[^:/\s#?]+|localhost)(:\d+)?((?:\/\w+)*\/)?([\w\-.]+[^#?\s]+)?([^#]+)?(#[\w-]*)?");

    protected override async Task OnInitializedAsync()
    {
        var accessTokenResult = await _tokenProvider.RequestAccessToken();
        if (accessTokenResult.TryGetToken(out var token))
        {
            _token = "Bearer " + token.Value;
        }

        userPhotoEndpoint = $"https://localhost:7088/api/users/{CurrentUser.Id}/photo";

        _occupations = await LocalStorage.GetItemAsync<ICollection<OccupationModel>>("occupations");

        if (_occupations is null)
        {
            var occupationsResponse = await OnebrbApiClient.ApiOccupationsAsync();

            if (occupationsResponse.StatusCode == (int)HttpStatusCode.OK)
            {
                _occupations = Mapper.Map<ICollection<OccupationModel>>(occupationsResponse.Result);

                if (_occupations?.Count > 0)
                {
                    await LocalStorage.SetItemAsync<ICollection<OccupationModel>>("occupations", _occupations);
                }
            }
        }
    }

    void OnProgress(UploadProgressArgs args)
    {
        if (args.Progress == 100)
        {
            foreach (var file in args.Files)
            {
                if (!IsValidImageFile(args.Files.SingleOrDefault()))
                {
                    return;
                }
            }
        }
    }

    void OnChange(UploadChangeEventArgs args)
    {
        _isUploadPhotoBtnDisabled = !IsValidImageFile(args.Files.SingleOrDefault());
    }

    private bool IsValidImageFile(FileInfo? fileInfo)
    {
        if (fileInfo == null || fileInfo.Size > MaxFileSizeInBytes)
        {
            return false;
        }

        var format = Path.GetExtension(fileInfo.Name);

        if (!allowedImageFormats.Contains(format)) 
        {
            return false;
        };

        return true;
    }

    void OnProfilePhotoChange(string value)
    {
        if (CurrentUser is not null)
            CurrentUser.Photo = value;
    }

    void OnProfilePhotoChangeError(UploadErrorEventArgs args)
    {
    }

    void OnOccupationChange(object value)
    {
        if (CurrentUser is not null)
            CurrentUser.OccupationId = value.ToString();

        var str = value is IEnumerable<object> ? string.Join(", ", (IEnumerable<object>)value) : value;
    }

    void OnEmailPrivacyChange(object value)
    {
        var str = value is IEnumerable<int> ? string.Join(", ", (IEnumerable<int>)value) : value;
    }

    void OnPhonePrivacyChange(object value)
    {
        var str = value is IEnumerable<int> ? string.Join(", ", (IEnumerable<int>)value) : value;
    }

    private async Task CheckSocialAccount(string? socialAccount)
    {
        if (!string.IsNullOrWhiteSpace(socialAccount))
        {
            if (urlRegex.IsMatch(socialAccount))
            {
                    await DialogService.OpenAsync("Account Error", ds =>
                    @<div>
                        The account name cannot contain url. Please put your account name only.
    </div>
    , new DialogOptions() { CloseDialogOnOverlayClick = true }); 
                return;
            }
        }
    }

    async Task OnUpdateProfileClick()
    {
        if (CurrentUser is null)
            return;

        _isUpdateBtnClicked = true;

        await CheckSocialAccount(CurrentUser.LinkedInProfile);
        await CheckSocialAccount(CurrentUser.FacebookProfile);
        await CheckSocialAccount(CurrentUser.InstagramProfile);

        try
        {
            var model = Mapper.Map<UpdateUserProfileRequestModel>(CurrentUser);

            var updateUserResponse = await OnebrbApiClient.ApiUsersPatchAsync(model);

            if (updateUserResponse.StatusCode == (int)HttpStatusCode.OK)
            {
                CurrentUser = Mapper.Map<UserProfileModel>(updateUserResponse.Result);
            }

            if (CurrentUser is not null)
            {
                _updatedUserProfile = true;
                await LocalStorage.SetItemAsync<UserProfileModel>("userProfile", CurrentUser);
            }
            else
                _updateUserProfileError = true;
        }
        catch (ApiException<ProblemDetails> ex)
        {
            ToastService.ClearAll();

            if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
            {
                ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
            }
        }
        catch (Exception)
        {
            ToastService.ShowError(@LocalizerShared["ErrorGenericMessage"]);
        }
    }

    async Task OnDeleteProfileClick()
    {
        bool? continueDelete = await DialogService.Confirm(@LocalizerProfile["EditProfile_DeleteProfileConfirm"], @LocalizerProfile["EditProfile_DeleteProfileConfirmTitle"], new ConfirmOptions() { OkButtonText = @LocalizerShared["Yes"], CancelButtonText = @LocalizerShared["No"] });

        if (continueDelete is true)
        {
            var response = await OnebrbApiClient.ApiUsersDeleteAsync();

            if (response.StatusCode != (int)HttpStatusCode.OK)
            {
                ToastService.ShowSuccess(@LocalizerProfile["EditProfile_DeleteProfileFailed"]);
            }
            else
            {
                ToastService.ShowError(@LocalizerProfile["EditProfile_DeleteProfileSuccess"]);
                await BeginLogout();
            }
        }
    }

    private async Task BeginLogout()
    {
        await SignOutManager.SetSignOutState();
        await LocalStorage.ClearAsync();
        Navigation.NavigateTo("authentication/logout");
    }

    void Cancel()
    {
        //
    }

    void Open(string title, Type type, Dictionary<string, object> parameters, DialogOptions options)
    {
    }

    void Close(dynamic result)
    {
    }

    public void Dispose()
    {
        DialogService.OnOpen -= Open;
        DialogService.OnClose -= Close;
    }
}
