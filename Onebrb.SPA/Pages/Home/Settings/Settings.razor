@page "/settings"
@using AutoMapper
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Onebrb.SPA.Models
@using System.Security.Claims
@using System.Net
@using System.Text.Json
@using Onebrb.SPA.Shared.Components
@using OnebrbApi

@attribute [Authorize]

@inject IConfiguration Configuration
@inject IHttpClientFactory ClientFactory
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IToastService ToastService
@inject IStringLocalizer<Settings> Localizer
@inject IStringLocalizer<Onebrb.SPA.Pages.Home.Profile.Profile> LocalizerProfile
@inject IStringLocalizer<Shared.Shared> LocalizerShared
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>@Localizer["SettingsPageTitle"]</PageTitle>

@*CHECK IF USER HAS ACTIVATED HIS PROFILE*@

@if (_currentUser is null)
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">
            <p>@LocalizerProfile["LoadingProfile"]</p>
        </RadzenText>
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenCard>

    return;
}

@if (_currentUser is not null)
{
    <EditProfileComponent CurrentUser="_currentUser" />
}

@code {
    private UserProfileModel? _currentUser;

    public class Profession
    {
        public int Id { get; set; }
        public string? Name { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Check local storage for user data
        _currentUser = await LocalStorage.GetItemAsync<UserProfileModel>("userProfile");

        if (_currentUser is null)
        {
            await GetCurrentUser();
        }
    }

    private void Cancel()
    {
    //
    }

    private async Task GetCurrentUser()
    {
        try
        {
            var currentUserResponse = await OnebrbApiClient.ApiUsersCurrentAsync();

            if (currentUserResponse.StatusCode == (int)HttpStatusCode.OK)
            {
                _currentUser = Mapper.Map<UserProfileModel>(currentUserResponse.Result);
                await LocalStorage.SetItemAsync<UserProfileModel>("userProfile", _currentUser);
            }
        }
        catch (ApiException<ProblemDetails> ex)
        {
            ToastService.ClearAll();

            if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
            {
                ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
            }
            if (ex.StatusCode == (int)HttpStatusCode.NotFound)
            {
                ToastService.ShowError(@Localizer["UserNotFound"]);
            }
        }
        catch (Exception)
        {
            ToastService.ShowError(@LocalizerShared["ErrorGenericMessage"]);
        }
    }
}