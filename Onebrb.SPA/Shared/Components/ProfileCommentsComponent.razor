@using AutoMapper
@using Onebrb.SPA.Models
@using OnebrbApi

@inject IHttpClientFactory ClientFactory
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject IStringLocalizer<Pages.Home.Shared.Shared> Loc
@inject IToastService ToastService
@inject DialogService DialogService

@implements IDisposable

@if (_comments is null)
{
    <p>No comments.</p>
}
else
{
    <RadzenTabs TabPosition="TabPosition.Top" RenderMode="TabRenderMode.Client" class="profile-comments">
        <Tabs>
            <RadzenTabsItem Text="Comments">
                @if (_comments.Count() == 0)
                {
                    <p>@Loc["UserHasNoComments"]</p>
                }
                else
                {
                    <RadzenDataList PageSize="4" WrapItems="true" AllowPaging="true" Data="@_comments" TItem="CommentModel">
                        <Template Context="comment">
                            <RadzenCard>
                                <div class="row">
                                    <div class="col-md-8 text-truncate">
                                        <b class="profile-comments__profile-commented-link" @onclick="OnProfileClick">@(comment.AuthorFirstName) @(comment.AuthorLastName)</b>
                                    </div>
                                    <div class="col-md-4 text-right profile-comments__comment-options">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Secondary">
                                            <StarComponent Value="@comment.StarRating" />
                                        </RadzenBadge>
                                        @if (CurrentUserId == comment.AuthorId) 
                                        {
                                            <i class="bi bi-pencil-fill" @onclick="() => ShowEditComment(comment)"></i>
                                            <i class="bi bi-trash3-fill" @onclick="() => OnCommentDelete(comment.Id)"></i>
                                        }
                                    </div>
                                </div>
                                <hr style="border: none; background-color: rgba(0,0,0,.08); height: 1px; margin: 1rem 0;" />
                                <div class="d-flex flex-row align-items-center">
                                    <RadzenImage Path="@comment.PhotoUrl" Class="rounded-circle float-left mr-3" Style="width: 80px; height: 80px;" />
                                    <div>
                                        <div style="font-size: .8em">@comment.Content</div>
                                    </div>
                                </div>
                            </RadzenCard>
                        </Template>
                    </RadzenDataList>
                }
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
}

@code {

    [Parameter]
    public string RecipientId { get; set; }

    [Parameter]
    public string CurrentUserId { get; set; }

    private string _updatedComment = string.Empty;

    private ICollection<CommentModel> _comments;

    private void OnProfileClick()
    {
        NavigationManager.NavigateTo("profiles/3", true);
    }

    private void OnCommentEditSubmit(string id)
    {
        Console.WriteLine($"Editting comment with id {id}");
    }

    private async Task OnCommentDelete(string id)
    {
        await OnebrbApiClient.CommentsDELETEAsync(id);
        ToastService.ClearSuccessToasts();
        ToastService.ShowSuccess("Comment deleted successfully.");
        await Refresh();
    }

    private async Task ShowEditComment(CommentModel comment)
    {
        var result = await DialogService.OpenAsync("Simple Dialog", ds =>
    @<div>
        <p class="mb-4">
            <RadzenTextArea Value=@comment.Content Change="(args) => OnCommentChange(args)" Class="w-100" />
        </p>
        <div class="row">
            <div class="col">
                <RadzenButton Text="Save" Click="() => OnCommentChangeSubmit(comment, ds.Close)" Class="mr-1" Style="width: 80px;" />
                <RadzenButton Text="Cancel" Click="() => ds.Close(false)" ButtonStyle="ButtonStyle.Secondary" Class="mr-1" />
            </div>
        </div>
    </div>
    );

    }

    void OnCommentChange(string commentText)
    {
        _updatedComment = commentText;
    }

    async Task OnCommentChangeSubmit(CommentModel comment, Action<dynamic> callback)
    {
        PatchCommentRequestModel patchComment = new()
            {
                Id = comment.Id,
                Content = _updatedComment,
                AuthorId = comment.AuthorId,
                RecipientId = RecipientId,
            };

        var updatedComment = await OnebrbApiClient.CommentsPATCHAsync(patchComment);

        var currentComment = _comments.SingleOrDefault(p => p.Id == updatedComment.Id);
        _comments.Remove(currentComment);

        currentComment = Mapper.Map<CommentModel>(updatedComment);
        _comments.Add(currentComment);

        StateHasChanged();
        ToastService.ClearSuccessToasts();
        ToastService.ShowSuccess("Success");
        callback.Invoke(true);
    }

    void Open(string title, Type type, Dictionary<string, object> parameters, DialogOptions options)
    {
    }

    void Close(dynamic result)
    {
    }

    public void Dispose()
    {
        // The DialogService is a singleton so it is advisable to unsubscribe.
        DialogService.OnOpen -= Open;
        DialogService.OnClose -= Close;
    }

    protected override async Task OnInitializedAsync()
    {
        _comments = Mapper.Map<ICollection<CommentModel>>(await OnebrbApiClient.CommentsAll2Async(RecipientId));
    }

    public async Task Refresh()
    {
        _comments = Mapper.Map<ICollection<CommentModel>>(await OnebrbApiClient.CommentsAll2Async(RecipientId));
        StateHasChanged();
    }
}
