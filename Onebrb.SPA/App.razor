@using Microsoft.AspNetCore.Components.WebAssembly.Services;
@using Onebrb.SPA.Shared.Components
@using System.Reflection;
@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared

@inject LazyAssemblyLoader lazyLoader

<CascadingAuthenticationState>
    @*<BytexDigital.Blazor.Components.CookieConsent.CookieConsentHandler>*@
    <Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@lazyLoadedAssemblies"
            OnNavigateAsync="@OnNavigateAsync">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <Authorizing>
                    Authorizing...
                </Authorizing>
                <NotAuthorized>
                   <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>@LocalizerShared["NothingAtThisAddress"]</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <ErrorComponent StatusCode="ResponseStatusCodeEnum.NotFound" Message="@LocalizerShared["NothingAtThisAddress"]" />
            </LayoutView>
        </NotFound>
    </Router>
    @*</BytexDigital.Blazor.Components.CookieConsent.CookieConsentHandler>*@
</CascadingAuthenticationState>

