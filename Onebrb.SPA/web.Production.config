<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

	<system.webServer>
		<httpProtocol>
			<customHeaders>
				<add xdt:Transform="SetAttributes" xdt:Locator="Match(name)" name="Blazor-Environment" value="{YOUR ENVIRONMENT HERE}" />
			</customHeaders>
		</httpProtocol>
		<httpCompression xdt:Transform="Replace">
			<dynamicTypes>
				<remove mimeType="text/*" />
				<remove mimeType="application/javascript" />
				<remove mimeType="image/svg+xml" />
			</dynamicTypes>
			<staticTypes>
				<remove mimeType="text/*" />
				<remove mimeType="application/javascript" />
				<remove mimeType="image/svg+xml" />
			</staticTypes>
		</httpCompression>
		<rewrite>
			<rules>
				<rule xdt:Transform="InsertBefore(/configuration/system.webServer/rewrite/rules/rule[@name='Rewrite brotli file'])"
				  name="Serve subdir">
					<match url=".*" />
					<action type="Rewrite" url="wwwroot\{R:0}" />
				</rule>
				<rule xdt:Transform="InsertAfter(/configuration/system.webServer/rewrite/rules/rule[@name='Rewrite gzip file'])"
				  name="SPA fallback routing" stopProcessing="true">
					<match url=".*" />
					<conditions logicalGrouping="MatchAll">
						<add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
					</conditions>
					<action type="Rewrite" url="wwwroot\" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>

</configuration>