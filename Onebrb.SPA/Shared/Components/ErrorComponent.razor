@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared

<div class="ErrorComponent">
    @if (StatusCode == ResponseStatusCodeEnum.NotFound)
    {
        // Can add some image for 404
        <img src="/img/404.jpeg" class="ErrorComponent__not-found" alt="@Message" />
    }

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <p class="ErrorComponent__message">@Message</p>
    }
</div>
@code {
    [Parameter]
    public ResponseStatusCodeEnum StatusCode { get; set; }

    [Parameter]
    public string? Message { get; set; }

    protected override Task OnParametersSetAsync()
    {
        Message = Message ?? DefaultMessage();

        return base.OnParametersSetAsync();
    }

    private string DefaultMessage()
    {
        // TODO: Check status code for custom message
        return @LocalizerShared["ErrorGenericMessage"];
    }
}