@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared


<RadzenCard class="login-form-component">
    <h2 class="mb-4">@LocalizerShared["WelcomeToOnebrb"]</h2>
    <RadzenTextBox Placeholder="Paste Onebrb ID here to see their profile'..." />
    <div class="login-form-component__social">
        <a href="authentication/login">
            <RadzenButton Click=@(args => OnBtnLoginClick()) Text="OR LOG IN :)" ButtonStyle="ButtonStyle.Primary" />
        </a>
    </div>
</RadzenCard>

@code {
    bool _busy = false;

    void OnBtnLoginClick()
    {
    }
    async Task OnBusyClick()
    {
        _busy = true;
        await Task.Delay(2000);
        _busy = false;
    }
}