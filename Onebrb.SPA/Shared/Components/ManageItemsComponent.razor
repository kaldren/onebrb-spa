@using Onebrb.SPA.Models
@using System.Linq

@inject NavigationManager Nav
@inject DialogService DialogService
@inject NavigationManager NavManager

@if (ProductModels is null || !ProductModels.Any())
{
    <p>You don't have any products yet. Create one?</p>
}
else
{
    <div class="manage-items-component">
        <RadzenDataGrid @ref="productsGrid" AllowFiltering="false" AllowPaging="true" PageSize="5" AllowSorting="true"
                    Data="@ProductModels" TItem="ProductModel">
            <Columns>
                <RadzenDataGridColumn Width="150px" TItem="ProductModel" Title="#" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="product">
                        <div class="manage-items-component__options">
                            <button type="button" class="btn btn-primary" title="Edit">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            <button type="button" class="btn btn-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ProductModel" Property="ProductModel.Title" Title="Product">
                    <Template Context="product">
                        <a href="products/@product.Id">
                            <RadzenImage Path="@product?.Images?.First()?.Path" style="width: 40px; height: 40px; border-radius: 8px; margin-right: 8px; float: left;" />
                            <h5 class="mt-1 mb-0">@product?.Title</h5>
                        </a>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="ProductModel" Property="ProductModel.Price" Title="Price" />

                <RadzenDataGridColumn TItem="ProductModel" Property="ProductModel.Date" Title="Date Created" FormatString="{0:d}" />

            </Columns>
        </RadzenDataGrid>
    </div>
}


@code {

    [Parameter]
    public IList<ProductModel>? ProductModels { get; set; }

    RadzenDataGrid<ProductModel> productsGrid;

