@page "/"

@using AutoMapper
@using Onebrb.SPA.Models
@using Onebrb.SPA.Shared.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using OnebrbApi
@using System.Net

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<Onebrb.SPA.Pages.Home.Profile.Profile> Loc
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper
@inject NavigationManager Navigation
@inject IToastService ToastService

@inject NavigationManager Navigation
@inject SignOutSessionStateManager SignOutManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>Onebrb</PageTitle>

<AuthorizeView>
    <Authorized>
        <p>Loading...</p>
    </Authorized>
    <NotAuthorized>
        <WelcomeComponent />
    </NotAuthorized>
</AuthorizeView>


@code {
    private UserProfileModel? _currentUser;
    private bool isAuthorized = false;
    string userIdClaim;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            bool? isAuth = authState?.User?.Identity?.IsAuthenticated;

            if (_currentUser is null && (isAuth.HasValue && isAuth.Value is true))
            {
                var userClaims = authState.User.Claims;
                userIdClaim = userClaims.Where(p => p.Type == "sub").First().Value;
                var userIsDeleted = await OnebrbApiClient.ApiUsersIsDeletedAsync(userIdClaim);

                if (userIsDeleted.Result == true)
                {
                    await SignOutManager.SetSignOutState();
                    await LocalStorage.ClearAsync();
                    Navigation.NavigateTo("authentication/logout");
                }

                if (!string.IsNullOrEmpty(userIdClaim))
                {
                    Navigation.NavigateTo($"/users/{userIdClaim}");
                }
            }
        }
        catch (ApiException<ProblemDetails> ex)
        {
            ToastService.ClearAll();

            if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
            {
                ToastService.ShowError("Unauthorized action.");
            }
            if (ex.StatusCode == (int)HttpStatusCode.NotFound)
            {
                Navigation.NavigateTo($"/users/{userIdClaim}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Sorry, please try again later.");
        }
    }
}