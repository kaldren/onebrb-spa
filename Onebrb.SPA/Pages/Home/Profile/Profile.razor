@page "/users/{Id?}"

@using AutoMapper
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication;
@using Onebrb.SPA.Interfaces;
@using Onebrb.SPA.Models
@using Onebrb.SPA.Shared.Components
@using OnebrbApi
@using System.Net
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@*@attribute [Authorize]*@

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<Profile> Localizer
@inject IStringLocalizer<Shared.Shared> LocalizerShared
@inject IOnebrbApiClient OnebrbApiClient
@inject IOnebrbApiClientPublic OnebrbApiClientPublic
@inject IMapper Mapper
@inject IToastService ToastService

@inject NavigationManager Navigation
@inject SignOutSessionStateManager SignOutManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>@Localizer["Profile"]</PageTitle>
@if (statusCodeEnum is not null)
{
    <ErrorComponent StatusCode="statusCodeEnum.Value" />

}
else if (Utils.AtLeastOneNull(_profile))
{
    <RadzenCard>
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">@LocalizerShared["Loading"]</RadzenText>
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenCard>
}
else
{
    <ProfileComponent CurrentUser="_currentUser" ProfileModel="_profile" CurrentUserCommented=_currentUserCommented />
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private UserProfileModel? _currentUser;
    private UserProfileModel? _profile;
    private ResponseStatusCodeEnum? statusCodeEnum;

    bool _currentUserCommented = true;

    OnebrbApiResponse<UserProfileResponseModel>? currentUserResponse;
    OnebrbApiResponse<UserProfileResponseModel>? userByIdResponse;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            await LoadAuthProfileData();
        }
        else
        {
            await LoadNotAuthProfileData();
        }
    }

    private async Task LoadAuthProfileData()
    {
        try
        {
            currentUserResponse = await OnebrbApiClient.ApiUsersCurrentAsync();
            _currentUser = Mapper.Map<UserProfileModel>(currentUserResponse.Result);

            if (_currentUser.Id == Id)
            {
                _profile = _currentUser;
            }
            else
            {
                userByIdResponse = await OnebrbApiClient.ApiUsersGetAsync(Id ?? _currentUser.Id);
                _profile = Mapper.Map<UserProfileModel>(userByIdResponse.Result);
            }
        }
        catch (ApiException<ProblemDetails> ex)
        {
            ToastService.ClearAll();

            if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
            {
                statusCodeEnum = ResponseStatusCodeEnum.Unauthorized;
                ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
            }
            if (ex.StatusCode == (int)HttpStatusCode.NotFound)
            {
                statusCodeEnum = ResponseStatusCodeEnum.NotFound;
                ToastService.ShowError(@Localizer["UserNotFound"]);

                // Delete profile
            }
        }
        catch (Exception ex)
        {
            statusCodeEnum = ResponseStatusCodeEnum.ServerError;
            ToastService.ShowError(@LocalizerShared["ErrorGenericMessage"]);
        }
    }

    private async Task LoadNotAuthProfileData()
    {
        try
        {
            userByIdResponse = await OnebrbApiClientPublic.ApiUsersGetAsync(Id);
            _profile = Mapper.Map<UserProfileModel>(userByIdResponse.Result);
        }
        catch (ApiException<ProblemDetails> ex)
        {
            ToastService.ClearAll();

            if (ex.StatusCode == (int)HttpStatusCode.Unauthorized)
            {
                statusCodeEnum = ResponseStatusCodeEnum.Unauthorized;
                ToastService.ShowError(@LocalizerShared["UnauthorizedAction"]);
            }
            if (ex.StatusCode == (int)HttpStatusCode.NotFound)
            {
                statusCodeEnum = ResponseStatusCodeEnum.NotFound;
                ToastService.ShowError(@Localizer["UserNotFound"]);
            }
        }
        catch (Exception)
        {
            statusCodeEnum = ResponseStatusCodeEnum.ServerError;
            ToastService.ShowError(@LocalizerShared["ErrorGenericMessage"]);
        }
    }
}
