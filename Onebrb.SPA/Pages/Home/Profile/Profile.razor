@page "/profiles/{Id}"

@using AutoMapper
@using Microsoft.AspNetCore.Authorization
@using Onebrb.SPA.Models
@using Onebrb.SPA.Shared.Components
@using OnebrbApi
@attribute [Authorize]

@inject IStringLocalizer<Profile> Loc
@inject IOnebrbApiClient OnebrbApiClient
@inject IMapper Mapper

<PageTitle>Profile</PageTitle>

@if (_profile is null)
{
    <p>Profile not found.</p>
}
else
{
    <ProfileComponent CurrentUser="_currentUser" ProfileModel="_profile" />
}

@code {
    [Parameter]
    public string? Id { get; set; }

    private UserProfileModel? _currentUser;
    private UserProfileModel? _profile;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = Mapper.Map<UserProfileModel>(await OnebrbApiClient.CurrentAsync());
        _profile = Mapper.Map<UserProfileModel>(await OnebrbApiClient.UsersGETAsync(Id));
    }
}
