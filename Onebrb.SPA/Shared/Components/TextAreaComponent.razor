@inject IStringLocalizer<Pages.Home.Shared.Shared> LocalizerShared

<div>
    <RadzenCard>
        <h4>@Text</h4>
        <RadzenTextArea Placeholder=@LocalizerShared["TextAreaPlaceholder"] Change="@((e) => OnChange.InvokeAsync(e))" />
    </RadzenCard>
</div>

@code {
    [Parameter]
    public string Text { get; set; }

    [Parameter] public EventCallback<string> OnChange { get; set; }
}
